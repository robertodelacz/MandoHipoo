var APS_AUD_COLS = ['Fecha', 'Usuario', 'Módulo', 'Acción', 'Referencia', 'Detalle'];
var APS_REP_COLS = ['Folio', 'Fecha', 'Usuario', 'Nombre', 'Rol', 'Tipo', 'Pantalla', 'Mensaje', 'Datos técnicos', 'Estado'];
/** Hoja auxiliar dentro del mismo archivo de registro (se crea sola si no existe). */
function APS_hojaAux_(nombre, cols) {
  var ss = SpreadsheetApp.openById(APS_ids_().hoja), sh = ss.getSheetByName(nombre);
  if (!sh) {
    sh = ss.insertSheet(nombre);
    sh.getRange(1, 1, 1, cols.length).setValues([cols]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}
/** Si la pestaña "Asesores" ya existía de antes de tener las columnas "Género" o "Rol" (opcionales), se las agrega
 * al final del encabezado — sin tocar las columnas ni los datos que ya haya. Las detecta por el TEXTO del
 * encabezado (igual que APS_parseAsesores_), no por posición, así que no importa en qué orden queden. */
function APS_aseguraColumnasAsesores_(sh) {
  var ultima = sh.getLastColumn(), header = ultima > 0 ? sh.getRange(1, 1, 1, ultima).getValues()[0] : [];
  var normal = header.map(function (v) { return String(v).toLowerCase().trim(); });
  var faltan = [];
  if (!normal.some(function (h) { return /^(genero|género|sexo|trato)/.test(h); })) faltan.push('Género');
  if (!normal.some(function (h) { return /^(rol|tipo|perfil|coordinador)/.test(h); })) faltan.push('Rol');
  if (faltan.length) sh.getRange(1, ultima + 1, 1, faltan.length).setValues([faltan]).setFontWeight('bold');
}
/** Bitácora de auditoría: quién hizo qué y cuándo (todo corre "como el dueño", así que Drive no lo distingue). Nunca interrumpe el flujo. */
function APS_audit_(modulo, accion, ref, detalle) {
  try {
    var sh = APS_hojaAux_('Auditoria', APS_AUD_COLS), fila = sh.getLastRow() + 1;
    if (fila > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 500);
    var rg = sh.getRange(fila, 1, 1, APS_AUD_COLS.length);
    rg.setNumberFormat('@');
    rg.setValues([[Utilities.formatDate(new Date(), APS_CONFIG.ZONA, 'yyyy-MM-dd HH:mm:ss'), APS_correo_() || '(sin identificar)', modulo, accion, ref || '', String(detalle || '').slice(0, 300)]]);
    CacheService.getScriptCache().put('APS_PANEL_V', String(new Date().getTime()), 21600);      // cualquier movimiento invalida el resumen guardado de la pantalla principal
  } catch (e) { Logger.log('Auditoría no registrada: ' + e.message); }
}

