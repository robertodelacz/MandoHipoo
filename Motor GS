/** Crea la carpeta de Drive y la hoja de registro, y guarda sus IDs. Es seguro volver a ejecutarla. */
function APS_setup() {
  APS_soloMantenimiento_();
  var props = PropertiesService.getScriptProperties(), carpeta = null, ss = null, id;
  if ((id = props.getProperty('APS_CARPETA_ID'))) { try { carpeta = DriveApp.getFolderById(id); } catch (e) { carpeta = null; } }
  if (!carpeta) { carpeta = DriveApp.createFolder('APS Hipoo (pruebas)'); props.setProperty('APS_CARPETA_ID', carpeta.getId()); }
  if ((id = props.getProperty('APS_HOJA_ID'))) { try { ss = SpreadsheetApp.openById(id); } catch (e) { ss = null; } }
  if (!ss) {
    ss = SpreadsheetApp.create('APS Hipoo · Registro');
    DriveApp.getFileById(ss.getId()).moveTo(carpeta);
    props.setProperty('APS_HOJA_ID', ss.getId());
  }
  var sh = ss.getSheetByName('Registros') || ss.getSheets()[0].setName('Registros');
  sh.getRange(1, 1, 1, APS_COLS.length).setValues([APS_COLS]).setFontWeight('bold');      // el encabezado se actualiza siempre (columnas nuevas)
  sh.setFrozenRows(1);
  APS_hojaAux_('Auditoria', APS_AUD_COLS); APS_hojaAux_('PLD_Revisiones', PLD_REV_COLS); APS_hojaAux_('Versiones', APS_VER_COLS);
  APS_aseguraColumnasAsesores_(APS_hojaAux_('Asesores', ['Correo', 'Nombre', 'Género', 'Rol', 'Activo']));   // si la pestaña ya existía (de antes de "Género"/"Rol"), les agrega las columnas que falten, sin tocar lo que ya hay
  Logger.log('Carpeta de PDFs : ' + carpeta.getUrl());
  Logger.log('Hoja de registro: ' + ss.getUrl());
  return { carpeta: carpeta.getUrl(), hoja: ss.getUrl() };
}

