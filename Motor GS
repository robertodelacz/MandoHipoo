/**
 * ANTES DE ACTIVAR EL BLOQUEO: ejecútala a mano (Ejecutar → ACCESO_diagnostico). Lista a TODAS las personas que han usado la
 * plataforma (contratos APS, Pre PLD de la bitácora, intentos registrados) y dice cuáles quedarían BLOQUEADAS por no estar
 * activas en la pestaña «Asesores». Agrega a quien deba seguir entrando ANTES de publicar la versión nueva.
 */
function ACCESO_diagnostico() {
  APS_soloMantenimiento_();
  var vistos = {};
  try { APS_todos_().forEach(function (r) { var e = String(r.asesor || '').toLowerCase(); if (e) vistos[e] = (vistos[e] || []).concat('contratos APS'); }); } catch (e) { }
  try { PLD_bitacora_().forEach(function (r) { var e = String(r.creador || '').toLowerCase(); if (e) vistos[e] = (vistos[e] || []).concat('Pre PLD'); }); } catch (e) { }
