  if (APS_CONFIG.BLOQUEO_ACCESO === false) return { ok: true, email: email };
  if (!email) return { ok: false, email: '', motivo: 'identidad' };
  if (dueno && email === dueno && !APS_inactivos_()[email]) return { ok: true, email: email };      // el dueño siempre entra, salvo que él mismo se dé de baja en la hoja (sirve para probar el bloqueo)
  if (APS_usuario_().puedeAps) return { ok: true, email: email };
  var hayConfigurados = Object.keys(APS_asesores_()).length + (APS_CONFIG.COORDINADORES || []).length;
