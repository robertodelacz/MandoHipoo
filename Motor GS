/* NOTA: el doGet() único está en tu Code.gs del Pre-PLD (sirve la pantalla 'Interfaz', que incluye este módulo). */
/** Devuelve el contenido de un archivo HTML para armar la pantalla. Los archivos de la consola solo se entregan a la administradora. */
function APS_incluir(nombre) {
  if (['PLD_Revision', 'APS_Nucleo', 'APS_Modulo', 'APS_Consola', 'APS_Tablero'].indexOf(nombre) < 0) throw new Error('Sin permiso.');   // solo los módulos de la pantalla; cualquier otro archivo HTML del proyecto no se entrega
  if (['APS_Consola', 'APS_Tablero'].indexOf(nombre) >= 0 && !APS_esAdmin()) throw new Error('Sin permiso.');
  if (['APS_Modulo', 'APS_Nucleo'].indexOf(nombre) >= 0 && !APS_puedeGenerarAps()) throw new Error('Sin permiso.');
  return HtmlService.createHtmlOutputFromFile(nombre).getContent();
}
/** ¿La cuenta que abre la aplicación es la administradora? (la usa la plantilla Interfaz.html) */
function APS_esAdmin() { return APS_usuario_().rol === 'coordinador'; }
/** ¿Puede generar contratos APS? (coordinadores y asesores de la lista de autorizados). La usa la plantilla Interfaz.html. */
function APS_puedeGenerarAps() { return APS_usuario_().puedeAps; }
/** Datos mínimos del usuario para la pantalla de bienvenida (JSON seguro para incrustarlo en la página). */
