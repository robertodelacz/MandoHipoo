 *     en particular (Interfaz.html los lee de la URL al cargar), en vez de dejar a quien lo recibe en la pantalla
 *     de inicio para que busque el contrato él mismo.
 *   - firma: nombre (y puesto) de quien hizo la acción, para mostrarlo al pie del correo — ej. la coordinadora
 *     que aprobó. Se toma del campo "Nombre" de la hoja Asesores, así que siempre corresponde a quien de verdad
 *     hizo la acción, sea Lizbeth o cualquier otra persona que tenga rol de coordinación más adelante.
 */
function APS_notificar_(para, asunto, mensaje, opts) {
  if (!APS_CONFIG.NOTIFICAR_CORREOS || !para || !para.length) return;
  opts = opts || {};
  // Limpia la lista: minúsculas, sin espacios, sin repetidos y solo direcciones con forma de correo.
  var vistos = {}, dest = [], malos = [];
  para.forEach(function (c) { var k = String(c || '').toLowerCase().trim(); if (!k || vistos[k]) return; vistos[k] = 1; if (APS_RE_CORREO_.test(k)) dest.push(k); else malos.push(k); });
  var ok = [], fallo = [];
  try {
    var url = ScriptApp.getService().getUrl();
    if (url && opts.params) {
      var qs = Object.keys(opts.params).map(function (k) { return k + '=' + encodeURIComponent(opts.params[k]); }).join('&');
      url += (url.indexOf('?') === -1 ? '?' : '&') + qs;
    }
    var correo = { to: dest.join(','), subject: '[' + (opts.sistema || 'APS Hipoo') + '] ' + asunto, name: opts.sistema || 'APS Hipoo',
      htmlBody: APS_correoHtml_(opts.titulo || asunto, mensaje, opts.sinBoton ? '' : url, opts.firma, opts) };
    if (opts.replyTo) correo.replyTo = opts.replyTo;
    // Si hay un alias de "Enviar como" configurado y verificado en la cuenta que ejecuta el script, se usa como
    // remitente real; si no (CORREO_REMITENTE vacío), Apps Script manda el correo desde esa misma cuenta (la tuya),
    // que es el comportamiento de hoy.
    if (APS_CONFIG.CORREO_REMITENTE) correo.from = APS_CONFIG.CORREO_REMITENTE;
    try { correo.inlineImages = { logoHipoo: DriveApp.getFileById(APS_CONFIG.LOGO_FILE_ID).getBlob().setName('logoHipoo') }; }
    catch (eLogo) { Logger.log('No se pudo adjuntar el logo al correo: ' + eLogo.message); }   // si falla, el correo se manda sin logo, no se cae el aviso
    if (dest.length) {
      try { MailApp.sendEmail(correo); ok = dest.slice(); }
      catch (eTodos) {
        // Un solo destinatario con problema hace fallar el envío completo: se reintenta uno por uno para que los demás sí reciban su aviso.
        Logger.log('Envío en grupo falló (' + eTodos.message + '); se reintenta uno por uno.');
        dest.forEach(function (d) { try { var c1 = Object.assign({}, correo, { to: d }); MailApp.sendEmail(c1); ok.push(d); } catch (e1) { fallo.push(d + ' (' + String(e1.message).slice(0, 80) + ')'); } });
      }
    }
  } catch (e) { Logger.log('No se pudo enviar correo: ' + e.message); fallo.push('error general: ' + String(e.message).slice(0, 100)); }
  malos.forEach(function (m) { fallo.push(m + ' (no parece un correo)'); });
  // Queda constancia en la auditoría de quién recibió el aviso y a quién no le llegó (así no hay que revisar el registro de ejecuciones).
  try { APS_audit_('APS', fallo.length ? 'CORREO_FALLO' : 'CORREO', '', String(asunto).slice(0, 70) + ' · ' + (ok.length ? 'a: ' + ok.join(', ') : '') + (fallo.length ? ' · NO llegó: ' + fallo.join('; ') : '')); } catch (e) { }
}

/**
 * DIAGNÓSTICO DE CORREOS: ejecútala a mano (Ejecutar → CORREO_diagnostico) o desde el editor.
