  APS_notificar_([u.email], 'Recibimos tu reporte (' + folio + ')', 'Gracias por avisarnos. Ya le llegó a la coordinación y a sistemas; te contestarán por correo si necesitan más información.',
    { titulo: 'Recibimos tu reporte', etiqueta: 'Folio ' + folio, tono: 'ok', sinBoton: true, datos: [['Folio', folio], ['Tipo', tipos[tipo]], ['Pantalla', pantalla], ['Lo que nos contaste', msg.slice(0, 300)]], sistema: 'APS Hipoo · Soporte' });
  return { folio: folio };
}

/* ═════════════ PANTALLA PRINCIPAL: indicadores y actividad en vivo ═════════════ */

/**
 * Datos de la pantalla principal. El asesor ve SOLO lo suyo; la coordinación ve el total del equipo.
 * Devuelve: contadores de contratos APS y de Pre PLD, y las últimas novedades (enviado, aprobado, cancelado,
 * observado, revisado). La pantalla lo consulta cada ~25 segundos; se guarda unos segundos en caché para que
 * muchas personas con la pantalla abierta no saturen la hoja.
 */
function APS_panel() {
  var u = APS_requiereUsuario_(), adm = u.rol === 'coordinador';
  var cache = CacheService.getScriptCache(), llave = 'APS_PANEL_' + (cache.get('APS_PANEL_V') || '0') + '_' + (adm ? 'ADM' : u.email), c = cache.get(llave);
  if (c) { try { return JSON.parse(c); } catch (e) { /* se recalcula */ } }
  var suyo = function (email) { return adm || String(email).toLowerCase() === u.email; };
  var aps = { borradores: 0, enRevision: 0, aprobados: 0, cancelados: 0, total: 0 }, apsMapa = {};
  APS_todos_().forEach(function (r) {
    apsMapa[r.id] = { dueno: r.asesor, titulo: r.propietarios, vigente: r.estado === 'EN_REVISION' };
    if (!suyo(r.asesor)) return;
    aps.total++;
    if (r.estado === 'BORRADOR') aps.borradores++; else if (r.estado === 'EN_REVISION') aps.enRevision++; else if (r.estado === 'APROBADO') aps.aprobados++; else if (r.estado === 'CANCELADO') aps.cancelados++;
  });
  var pld = null, pldMapa = {};
  try {
    pld = { sinEnviar: 0, enRevision: 0, observados: 0, revisados: 0, total: 0 };
    PLD_items_().forEach(function (x) {
      pldMapa[x.id] = { dueno: x.creador, titulo: x.nombre, vigente: x.estado === 'EN_REVISION' };
      if (!suyo(x.creador)) return;
      pld.total++;
      if (x.estado === 'SIN_ENVIAR') pld.sinEnviar++; else if (x.estado === 'EN_REVISION') pld.enRevision++; else if (x.estado === 'OBSERVADO') pld.observados++; else if (x.estado === 'REVISADO') pld.revisados++;
    });
  } catch (e) { pld = null; }      // si la bitácora del Pre PLD no está disponible, la pantalla solo oculta esa tarjeta
  var eventos = [], sh = APS_hojaAux_('Auditoria', APS_AUD_COLS), ult = sh.getLastRow();
  if (ult >= 2) {
    var desde = Math.max(2, ult - 599);
    var filas = sh.getRange(desde, 1, ult - desde + 1, 6).getValues();
    for (var i = filas.length - 1; i >= 0 && eventos.length < 40; i--) {
      var v = filas[i], mod = String(v[2]), acc = String(v[3]), ref = String(v[4]), det = String(v[5]), actor = String(v[1]);
      var ctx = (mod === 'APS' ? apsMapa : (mod === 'PLD' ? pldMapa : null));
      if (!ctx || !ctx[ref]) continue;
      var dueno = String(ctx[ref].dueno).toLowerCase(), titulo = ctx[ref].titulo, vigente = ctx[ref].vigente, propio = dueno === u.email, quien = APS_nombreDe_(actor), e = null;
      if (!adm && !propio) continue;
      var motivo = det.indexOf(' · ') >= 0 ? det.split(' · ').slice(1).join(' · ') : det;
      if (mod === 'APS') {
        if (acc === 'ENVIAR_REVISION') e = adm ? { tono: vigente ? 'warn' : 'info', titulo: vigente ? 'Contrato por revisar' : 'Contrato enviado a revisión', texto: APS_nombreDe_(dueno) + ' envió el contrato de ' + titulo + '.', accionable: vigente }
                                              : { tono: 'info', titulo: 'Enviaste un contrato a revisión', texto: titulo + (vigente ? ' está en revisión; te avisamos cuando se apruebe.' : ' fue enviado a revisión.') };
        else if (acc === 'APROBAR') e = { tono: 'ok', titulo: 'Contrato aprobado', texto: adm ? quien + ' aprobó el contrato de ' + titulo + '.' : 'El contrato de ' + titulo + ' ya fue aprobado. Ya puedes descargar el PDF.', accionable: !adm };
        else if (acc === 'CANCELAR') e = { tono: 'bad', titulo: 'Contrato cancelado', texto: 'El contrato de ' + titulo + ' se canceló. Motivo: ' + motivo, accionable: !adm };
      } else {
        if (acc === 'ENVIAR_REVISION') e = adm ? { tono: vigente ? 'warn' : 'info', titulo: vigente ? 'Pre PLD por revisar' : 'Pre PLD enviado a revisión', texto: APS_nombreDe_(dueno) + ' envió «' + titulo + '».', accionable: vigente }
                                              : { tono: 'info', titulo: 'Enviaste un Pre PLD a revisión', texto: '«' + titulo + (vigente ? '» está en revisión.' : '» fue enviado a revisión.') };
        else if (acc === 'OBSERVAR') e = { tono: 'warn', titulo: 'Pre PLD con observaciones', texto: '«' + titulo + '»: ' + motivo, accionable: !adm };
        else if (acc === 'REVISADO') e = { tono: 'ok', titulo: 'Pre PLD revisado', texto: '«' + titulo + '» fue revisado' + (adm ? ' por ' + quien + '.' : '. No tiene observaciones.'), accionable: !adm };
      }
      if (e) { e.modulo = mod; e.id = ref; e.fecha = String(v[0]); e.propio = propio; eventos.push(e); }
    }
  }
  var res = { ahora: Utilities.formatDate(new Date(), APS_CONFIG.ZONA, 'yyyy-MM-dd HH:mm:ss'), rol: u.rol, aps: aps, pld: pld, eventos: eventos };
  try { cache.put(llave, JSON.stringify(res), 8); } catch (e) { /* sin caché: solo vuelve a leer la hoja */ }
  return res;
}

/* ═════════════ UTILIDADES: huellas, versiones y diferencias ═════════════ */

/** SHA-256 en hexadecimal de un texto o de bytes. */
function APS_sha256_(entrada) {
  var bytes = (typeof entrada === 'string') ? Utilities.newBlob(entrada).getBytes() : entrada;
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes).map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}
/** JSON con las llaves en orden fijo: el mismo contenido siempre da la misma huella. */
function APS_estable_(v) {
  if (Array.isArray(v)) return '[' + v.map(APS_estable_).join(',') + ']';
  if (v && typeof v === 'object') return '{' + Object.keys(v).sort().map(function (k) { return JSON.stringify(k) + ':' + APS_estable_(v[k]); }).join(',') + '}';
  return JSON.stringify(v === undefined ? null : v);
}
/** Guarda una copia completa del contrato (quién, cuándo y en qué estado) para poder ver después qué cambió. */
function APS_snapshot_(reg, u, accion) {
  try {
    var sh = APS_hojaAux_('Versiones', APS_VER_COLS), fila = sh.getLastRow() + 1;
    if (fila > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 200);
    var rg = sh.getRange(fila, 1, 1, APS_VER_COLS.length);
    rg.setNumberFormat('@');
    rg.setValues([[APS_ahora_(), reg.id, reg.version || 1, (u && u.email) || APS_correo_(), reg.estado, accion, reg.json]]);
  } catch (e) { Logger.log('Versión no registrada: ' + e.message); }
}
function APS_aplana_(v, pre, out) {
  out = out || {};
  if (Array.isArray(v)) { v.forEach(function (x, i) { APS_aplana_(x, pre + (pre ? '.' : '') + i, out); }); if (!v.length) out[pre] = ''; }
  else if (v && typeof v === 'object') Object.keys(v).forEach(function (k) { APS_aplana_(v[k], pre + (pre ? '.' : '') + k, out); });
  else out[pre] = v == null ? '' : String(v);
  return out;
}
/** Lista de cambios entre dos versiones: [{campo, antes, despues}]. */
function APS_diff_(a, b) {
  var A = APS_aplana_(a || {}, '', {}), B = APS_aplana_(b || {}, '', {}), cambios = [], vistos = {};
  Object.keys(A).concat(Object.keys(B)).forEach(function (k) {
    if (vistos[k]) return; vistos[k] = 1;
    if ((A[k] || '') !== (B[k] || '')) cambios.push({ campo: k, antes: A[k] || '', despues: B[k] || '' });
  });
  return cambios.slice(0, 80);
}

/* ═════════════ API PARA LA PANTALLA (continúa) ═════════════ */

/**
 * filtro: 'mios' | 'revision' | 'todos'. El asesor solo ve lo suyo, aunque pida 'todos'.
 * texto: búsqueda (ID, propietarios, inmueble, asesor). limite: filas a devolver (máx. 1000).
 * Devuelve { filas, total, conteos }: los conteos son de TODO lo que la persona puede ver, no solo de las filas devueltas.
 */
function APS_listar(filtro, texto, limite) {
  var u = APS_requiereAps_(), adm = u.rol === 'coordinador', q = String(texto || '').toLowerCase().trim(), lim = Math.max(1, Math.min(Number(limite) || 300, 1000));
  var base = APS_todos_().filter(function (r) {
    if (!adm) return r.asesor === u.email;
    if (filtro === 'revision') return r.estado === 'EN_REVISION';
    if (filtro === 'mios') return r.asesor === u.email;
    return true;
  });
  var conteos = { total: base.length, SIN_TERMINAR: 0, COMPLETO: 0, EN_REVISION: 0, APROBADO: 0, CANCELADO: 0, conDocs: 0 };
  base.forEach(function (r) { var ui = APS_estadoUI_(r); conteos[ui] = (conteos[ui] || 0) + 1; if (r.docUrl) conteos.conDocs++; });
  var filas = q ? base.filter(function (r) { return [r.id, r.propietarios, r.inmueble, r.asesor].join(' ').toLowerCase().indexOf(q) >= 0; }) : base;
  filas.sort(function (a, b) { return a.actualizado < b.actualizado ? 1 : -1; });
  return { filas: filas.slice(0, lim).map(function (r) { return APS_meta_(r, adm); }), total: filas.length, conteos: conteos };
}

function APS_abrir(id) {
  var u = APS_requiereAps_(), f = APS_buscar_(id);
  if (!f || !APS_puedeVer_(f.reg, u)) throw new Error('No se encontró el registro o no tienes acceso a él.');
  return { meta: APS_meta_(f.reg), datos: JSON.parse(f.reg.json) };
}

/** Limpia lo que llega de la pantalla: quita caracteres de control, recorta espacios y pone tope al largo de cada campo. */
function APS_limpiarDatos_(datos) {
  if (!datos || typeof datos !== 'object') throw new Error('Datos inválidos.');
  var o = JSON.parse(JSON.stringify(datos));
  if (!Array.isArray(o.propietarios) || o.propietarios.length < 1 || o.propietarios.length > 4) throw new Error('Debe haber de 1 a 4 propietarios.');
  if (Array.isArray(o.ajustes) && o.ajustes.length > 15) throw new Error('Máximo 15 ajustes de precio.');
  var libres = { inmDomicilio: 1, instalaciones: 1 };           // los únicos campos donde se permiten saltos de línea
  function limpia(v, llave) {
    if (typeof v === 'string') {
      var t = v.replace(libres[llave] ? /[\u0000-\u0009\u000b\u000c\u000e-\u001f\u007f]/g : /[\u0000-\u001f\u007f]/g, ' ').trim();
      if (t.length > 600) throw new Error('El campo "' + llave + '" es demasiado largo (máximo 600 caracteres).');
      return t;
    }
    if (Array.isArray(v)) return v.map(function (x) { return limpia(x, llave); });
    if (v && typeof v === 'object') { var r = {}; Object.keys(v).forEach(function (k) { r[k] = limpia(v[k], k); }); return r; }
    return v;
  }
  o = limpia(o, '');
  if (JSON.stringify(o).length > 40000) throw new Error('El registro es demasiado grande.');
  return o;
}

/** Crea (id vacío) o actualiza un borrador. versionBase: la versión que la pantalla tenía abierta; si otra persona guardó antes, avisa en vez de pisar sus cambios. */
function APS_guardar(datos, id, versionBase) {
  var u = APS_requiereAps_(), o = APS_limpiarDatos_(datos), res = APS_resumen_(o), pend = APS_nucleo_().D.validar(o).length;
  return APS_conLock_(function () {
    var ahora = APS_ahora_();
    if (!id) {
      var tomados = {};
      APS_todos_().forEach(function (r) { tomados[r.id] = 1; });
      var reg = { id: APS_nuevoId_(tomados), creado: ahora, actualizado: ahora, asesor: u.email, estado: 'BORRADOR', tipo: res.tipo,
        propietarios: res.propietarios, inmueble: res.inmueble, json: JSON.stringify(o), pdfUrl: '', pdfId: '', comentario: '', revisadoPor: '', pendientes: pend, docUrl: '', docFecha: '', version: 1 };
      var sh = APS_hoja_(), fila = sh.getLastRow() + 1;
      if (fila > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 200);   // la hoja crece sola
      APS_escribir_(sh, fila, reg);
      APS_audit_('APS', 'CREAR', reg.id, res.propietarios);
      return APS_meta_(reg);
    }
    var f = APS_buscar_(id);
    if (!f) throw new Error('No existe el registro ' + id + '.');
    if (!APS_puedeEditar_(f.reg, u)) throw new Error('No puedes editar este registro (estado: ' + f.reg.estado + ').');
    if (versionBase != null && Number(versionBase) !== f.reg.version) throw new Error('Este contrato lo modificó otra persona mientras lo tenías abierto. Ábrelo de nuevo desde «Mis contratos» para ver los cambios y no perderlos.');
    var nuevoJson = JSON.stringify(o);
    if (nuevoJson === f.reg.json) return APS_meta_(f.reg);               // nada cambió: no se escribe, no se sube la versión
    f.reg.actualizado = ahora; f.reg.tipo = res.tipo; f.reg.propietarios = res.propietarios; f.reg.inmueble = res.inmueble; f.reg.json = nuevoJson; f.reg.pendientes = pend; f.reg.version = (f.reg.version || 1) + 1;
    APS_escribir_(f.hoja, f.fila, f.reg);
    if (f.reg.estado !== 'BORRADOR') APS_snapshot_(f.reg, u, 'EDICION_COORDINACION');       // desde que se envía, cada cambio de la coordinación queda guardado completo
    APS_audit_('APS', 'EDITAR', f.reg.id, 'Estado: ' + f.reg.estado + ' · v' + f.reg.version);
    return APS_meta_(f.reg);
  });
}

/** Asesor (dueño) o coordinador: BORRADOR → EN_REVISION. Exige datos completos. A partir de aquí, la coordinación
 * tiene control total: puede corregir cualquier dato y aprobar; el contrato ya no se le regresa al asesor. */
function APS_enviarRevision(id) {
  var u = APS_requiereAps_(), N = APS_nucleo_();
  return APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f || !APS_puedeVer_(f.reg, u)) throw new Error('No se encontró el registro.');
    if (f.reg.estado !== 'BORRADOR') throw new Error('Solo se puede enviar un borrador (estado actual: ' + f.reg.estado + ').');
    if (u.rol !== 'coordinador' && f.reg.asesor !== u.email) throw new Error('Solo el asesor que lo creó puede enviarlo.');
    var pend = N.D.validar(JSON.parse(f.reg.json));
    if (pend.length) throw new Error('Faltan ' + pend.length + ' dato(s): ' + pend.slice(0, 3).map(function (p) { return p.msg; }).join('; ') + (pend.length > 3 ? '…' : ''));
    f.reg.estado = 'EN_REVISION'; f.reg.actualizado = APS_ahora_(); f.reg.version = (f.reg.version || 1) + 1;
    APS_escribir_(f.hoja, f.fila, f.reg);
    APS_snapshot_(f.reg, u, 'ENVIO');                                   // lo que el asesor mandó, tal cual
    APS_audit_('APS', 'ENVIAR_REVISION', f.reg.id, f.reg.propietarios);
    APS_notificar_(APS_coordinadores_(), 'Contrato por revisar — ' + f.reg.propietarios + ' (' + f.reg.id + ')',
      '<b>' + APS_escHtml_(APS_nombreDe_(f.reg.asesor)) + '</b> envió a revisión un contrato. Ábrelo con el botón: podrás revisarlo, corregir lo que haga falta y aprobarlo.',
      { params: { modulo: 'aps', id: f.reg.id }, titulo: 'Hay un contrato esperando tu revisión', etiqueta: 'Por revisar', tono: 'warn', boton: 'Revisar el contrato',
        datos: APS_datosCorreo_(f.reg, [['Asesor', APS_nombreDe_(f.reg.asesor) + ' · ' + f.reg.asesor], ['Enviado', f.reg.actualizado]]) });
    APS_notificar_([f.reg.asesor], 'Recibimos tu contrato — ' + f.reg.propietarios + ' (' + f.reg.id + ')',
      'Tu contrato quedó <b>en revisión</b>. La coordinación lo revisará, ajustará lo que haga falta y lo aprobará; te avisamos en cuanto esté listo. Mientras tanto ya no puedes editarlo.',
      { params: { modulo: 'aps', id: f.reg.id }, titulo: 'Tu contrato está en revisión', etiqueta: 'En revisión', tono: 'info', boton: 'Ver el estado del contrato',
        datos: APS_datosCorreo_(f.reg, [['Enviado', f.reg.actualizado]]) });
    return APS_meta_(f.reg);
  });
}

/** Texto de sello que se imprime al final del PDF aprobado: permite comprobar después que es el mismo contrato. */
function APS_selloTexto_(reg, u, datosHash, ahora) {
  return 'Folio ' + reg.id + ' · versión ' + (reg.version || 1) + ' · Aprobado por la coordinación (' + (u.nombre || u.email) + ') el ' + ahora + ' · Huella de los datos (SHA-256): ' + datosHash.slice(0, 16) + '. Verificación: abrir el folio en el sistema APS.';
}

/**
 * Solo coordinador: EN_REVISION → APROBADO. Genera el PDF definitivo y lo guarda en la carpeta de Drive.
 * El PDF (lo lento) se genera FUERA del bloqueo general; al terminar se vuelve a comprobar que el contrato no cambió
 * mientras tanto. Si ya estaba aprobado (doble clic, reintento tras una pantalla que se quedó esperando), devuelve el resultado en vez de fallar.
 */
function APS_aprobar(id) {
  var u = APS_requiereUsuario_(), N = APS_nucleo_();
  if (u.rol !== 'coordinador') throw new Error('Solo el coordinador puede aprobar registros.');
  var snap = APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f) throw new Error('No se encontró el registro.');
    if (f.reg.estado === 'APROBADO') return { yaAprobado: true, meta: APS_meta_(f.reg) };
    if (f.reg.estado !== 'EN_REVISION') throw new Error('Solo se puede aprobar un registro en revisión (estado actual: ' + f.reg.estado + ').');
    if (!APS_CONFIG.PERMITIR_AUTOAPROBACION && f.reg.asesor === u.email) throw new Error('Este contrato lo creaste tú: debe aprobarlo otra persona de la coordinación.');
    var datos = JSON.parse(f.reg.json), pend = N.D.validar(datos);
    if (pend.length) throw new Error('Faltan ' + pend.length + ' dato(s): ' + pend.slice(0, 3).map(function (p) { return p.msg; }).join('; '));
    return { json: f.reg.json, version: f.reg.version || 1, reg: f.reg };
  });
  if (snap.yaAprobado) return snap.meta;

  var datos = JSON.parse(snap.json), datosHash = APS_sha256_(APS_estable_(datos)), ahora = APS_ahora_();
  var regSello = Object.assign({}, snap.reg, { version: snap.version });
  var blob = APS_pdfBlob_(datos, APS_nombrePdf_(snap.reg, datos), false, APS_selloTexto_(regSello, u, datosHash, ahora));
  var pdfSha = APS_sha256_(blob.getBytes());
  var archivo = DriveApp.getFolderById(APS_ids_().carpeta).createFile(blob);
  var coord = APS_coordinadores_();

  return APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f) { try { archivo.setTrashed(true); } catch (e) {} throw new Error('El contrato ya no existe.'); }
    if (f.reg.estado === 'APROBADO') { try { archivo.setTrashed(true); } catch (e) {} return APS_meta_(f.reg); }          // otra persona lo aprobó en ese lapso
    if (f.reg.estado !== 'EN_REVISION' || (f.reg.version || 1) !== snap.version) {
      try { archivo.setTrashed(true); } catch (e) {}
      throw new Error('El contrato cambió mientras se generaba el PDF. Ábrelo de nuevo, revisa y vuelve a aprobar.');
    }
    coord.forEach(function (c) { try { archivo.addViewer(c); } catch (e) { Logger.log('No se pudo compartir el PDF con ' + c + ': ' + e.message); } });   // para poder verlo en Drive
    f.reg.estado = 'APROBADO'; f.reg.pdfUrl = archivo.getUrl(); f.reg.pdfId = archivo.getId(); f.reg.revisadoPor = u.email; f.reg.actualizado = ahora;
    f.reg.version = snap.version + 1; f.reg.pdfSha = pdfSha; f.reg.datosHash = datosHash; f.reg.aprobadoEn = ahora;
    APS_escribir_(f.hoja, f.fila, f.reg);
    APS_snapshot_(f.reg, u, 'APROBACION');
    APS_audit_('APS', 'APROBAR', f.reg.id, 'PDF ' + f.reg.pdfId + ' · SHA ' + pdfSha.slice(0, 16) + ' · datos ' + datosHash.slice(0, 16));
    APS_notificar_([f.reg.asesor], 'Contrato aprobado — ' + f.reg.propietarios + ' (' + f.reg.id + ')',
      'La coordinación aprobó tu contrato. Ya puedes entrar al sistema y descargar el PDF definitivo.',
      { params: { modulo: 'aps', id: f.reg.id }, firma: u.nombre ? ('Aprobado por ' + u.nombre) : 'Aprobado por la coordinación', titulo: 'Tu contrato fue aprobado', etiqueta: 'Aprobado', tono: 'ok', boton: 'Descargar el PDF',
        datos: APS_datosCorreo_(f.reg, [['Aprobado', ahora], ['Versión', String(f.reg.version)], ['Huella de los datos', datosHash.slice(0, 16)]]) });
    return APS_meta_(f.reg);
  });
}

/**
 * SOLO COORDINACIÓN: cancela un contrato enviado o aprobado (queda en el registro, con motivo, quién y cuándo; el PDF
 * aprobado se conserva). Reemplaza al borrado permanente: no se pierde evidencia.
 */
function APS_cancelar(id, motivo) {
  var u = APS_requiereAdmin_();
  motivo = String(motivo || '').replace(/[\u0000-\u001f\u007f]/g, ' ').trim().slice(0, 300);
  if (motivo.length < 5) throw new Error('Escribe el motivo de la cancelación (mínimo 5 caracteres).');
  return APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f) throw new Error('No se encontró el registro.');
    if (f.reg.estado === 'CANCELADO') return APS_meta_(f.reg);
    if (f.reg.estado === 'BORRADOR') throw new Error('Un borrador sin enviar no se cancela: se elimina.');
    var antes = f.reg.estado;
    f.reg.estado = 'CANCELADO'; f.reg.comentario = motivo; f.reg.revisadoPor = u.email; f.reg.actualizado = APS_ahora_(); f.reg.version = (f.reg.version || 1) + 1;
    APS_escribir_(f.hoja, f.fila, f.reg);
    APS_snapshot_(f.reg, u, 'CANCELACION');
    APS_audit_('APS', 'CANCELAR', f.reg.id, 'Estaba en ' + antes + ' · ' + motivo);
    APS_notificar_([f.reg.asesor], 'Contrato cancelado — ' + f.reg.propietarios + ' (' + f.reg.id + ')',
      'La coordinación canceló este contrato. Si crees que es un error, habla con ella antes de generar uno nuevo.',
      { params: { modulo: 'aps', id: f.reg.id }, firma: u.nombre ? ('Cancelado por ' + u.nombre) : 'Cancelado por la coordinación', titulo: 'Tu contrato fue cancelado', etiqueta: 'Cancelado', tono: 'bad', boton: 'Ver el contrato',
        datos: APS_datosCorreo_(f.reg, [['Motivo', motivo]]) });
    return APS_meta_(f.reg);
  });
}

/**
 * SOLO COORDINACIÓN: elimina un BORRADOR (nunca enviado). Los contratos enviados o aprobados no se borran: se cancelan
 * (APS_cancelar). Antes de borrar se guarda una copia completa en la hoja Versiones.
 */
function APS_eliminar(id) {
  var u = APS_requiereAdmin_();
  return APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f) throw new Error('No se encontró el registro.');
    if (f.reg.estado !== 'BORRADOR') throw new Error('Solo se pueden eliminar borradores. Un contrato enviado o aprobado se cancela (queda el registro con su motivo).');
    var detalle = f.reg.id + ' (' + f.reg.propietarios + ') · borrador';
    APS_snapshot_(f.reg, u, 'ELIMINADO');
    f.hoja.deleteRow(f.fila);
    APS_audit_('APS', 'ELIMINAR', id, detalle);
    return { ok: true };
  });
}

/**
 * Asesor (dueño): descarta un borrador que NUNCA se envió a revisión (sin PDF de por medio). Los enviados o aprobados
 * ya no los toca el asesor. Queda constancia en Auditoría.
 */
function APS_descartarBorrador(id) {
  var u = APS_requiereAps_();
  return APS_conLock_(function () {
    var f = APS_buscar_(id);
    if (!f || f.reg.asesor !== u.email) throw new Error('No se encontró el borrador.');
    if (f.reg.estado !== 'BORRADOR') throw new Error('Solo se pueden descartar borradores que no se han enviado a revisión.');
    f.hoja.deleteRow(f.fila);
    APS_audit_('APS', 'DESCARTAR_BORRADOR', id, f.reg.propietarios);
    return { ok: true };
  });
}

/** SOLO COORDINACIÓN: historial de versiones de un contrato, con lo que cambió en cada una respecto a la anterior. */
function APS_versiones(id) {
  APS_requiereAdmin_();
  var sh = APS_hojaAux_('Versiones', APS_VER_COLS), n = sh.getLastRow() - 1, out = [];
  if (n < 1) return out;
  var ids = sh.getRange(2, 2, n, 1).getValues(), prev = null;
  for (var i = 0; i < n; i++) {
    if (String(ids[i][0]) !== String(id)) continue;
    var v = sh.getRange(i + 2, 1, 1, APS_VER_COLS.length).getValues()[0], datos = null;
    try { datos = JSON.parse(String(v[6])); } catch (e) { datos = null; }
    out.push({ fecha: String(v[0]), version: Number(v[2]) || 0, usuario: String(v[3]), estado: String(v[4]), accion: String(v[5]), cambios: (prev && datos) ? APS_diff_(prev, datos) : [] });
    if (datos) prev = datos;
  }
  return out.reverse();
}

/** Contratos activos (no cancelados) que coinciden en folio real, domicilio del inmueble o RFC de algún propietario con el que se indica. */
function APS_duplicados(id) {
  var u = APS_requiereAps_(), f = APS_buscar_(id);
  if (!f || !APS_puedeVer_(f.reg, u)) throw new Error('No se encontró el registro.');
  var adm = u.rol === 'coordinador', norm = function (t) { return String(t || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, ''); };
  var base = JSON.parse(f.reg.json), folio = norm(base.folioReal), dom = norm(base.inmDomicilio), rfcs = {};
  (base.propietarios || []).forEach(function (p) { var r = norm(p.rfc); if (r.length >= 12 && (p.rfcModo || 'normal') === 'normal') rfcs[r] = 1; });
  var out = [];
  APS_todos_().forEach(function (r) {
    if (r.id === f.reg.id || r.estado === 'CANCELADO') return;
    var d; try { d = JSON.parse(r.json); } catch (e) { return; }
    var motivos = [];
    if (folio.length >= 4 && norm(d.folioReal) === folio) motivos.push('el mismo folio real');
    if (dom.length >= 12 && norm(d.inmDomicilio) === dom) motivos.push('el mismo domicilio del inmueble');
    if ((d.propietarios || []).some(function (p) { var x = norm(p.rfc); return x.length >= 12 && rfcs[x]; })) motivos.push('el mismo RFC de un propietario');
    if (motivos.length) out.push({ id: (adm || r.asesor === u.email) ? r.id : 'de otro asesor', estado: r.estado, propio: r.asesor === u.email, motivo: motivos.join(' y ') });
  });
  return out.slice(0, 10);
}

/** Datos para comprobar un contrato aprobado: folio, versión, quién lo aprobó, cuándo y las huellas. Lo puede ver el asesor dueño y la coordinación. */
function APS_verificar(id) {
  var u = APS_requiereAps_(), f = APS_buscar_(id);
  if (!f || !APS_puedeVer_(f.reg, u)) throw new Error('No se encontró el registro o no tienes acceso a él.');
  var r = f.reg, vigente = true;
  if (r.estado === 'APROBADO') { try { vigente = APS_sha256_(APS_estable_(JSON.parse(r.json))) === r.datosHash; } catch (e) { vigente = false; } }
  return { id: r.id, estado: r.estado, version: r.version || 1, aprobadoPor: r.revisadoPor, aprobadoEn: r.aprobadoEn, huellaDatos: r.datosHash, huellaPdf: r.pdfSha, datosCoincidenConHuella: r.estado === 'APROBADO' ? vigente : null };
}

/**
 * Devuelve el PDF aprobado en base64, sin dar acceso a la carpeta de Drive.
 * Regla: el coordinador siempre puede. El asesor SOLO puede descargar el PDF de un contrato que sea suyo
 * (REG.asesor === su correo) y única y exclusivamente cuando ESE contrato ya está en estado APROBADO.
 * Antes de la aprobación, aunque el asesor pida este PDF directamente, se le niega.
 * Antes de entregarlo se comprueba que el archivo en Drive sea el mismo que se generó al aprobar (huella SHA-256).
 */
function APS_obtenerPdf(id) {
  var u = APS_requiereAps_(), f = APS_buscar_(id);
  if (!f || !APS_puedeVer_(f.reg, u)) throw new Error('No se encontró el registro o no tienes acceso a él.');
  var esDueno = f.reg.asesor === u.email, adm = u.rol === 'coordinador';
  if (!adm && !esDueno) throw new Error('No tienes acceso al PDF de este registro.');
  var habilitado = f.reg.estado === 'APROBADO' || (adm && f.reg.estado === 'CANCELADO');
  if (!habilitado || !f.reg.pdfId) {
    throw new Error(esDueno && !adm
      ? 'Todavía no puedes descargar este PDF: solo se habilita cuando la coordinación aprueba el contrato.'
      : 'Este registro todavía no tiene PDF aprobado.');
  }
  var blob = DriveApp.getFileById(f.reg.pdfId).getBlob(), sha = APS_sha256_(blob.getBytes());
  if (f.reg.pdfSha && sha !== f.reg.pdfSha) {
    APS_audit_('APS', 'PDF_NO_COINCIDE', f.reg.id, 'Esperada ' + f.reg.pdfSha.slice(0, 16) + ' · actual ' + sha.slice(0, 16));
    throw new Error('El PDF guardado en Drive ya no coincide con el que se generó al aprobar. No se entrega; avisa a la coordinación.');
  }
  APS_audit_('APS', 'DESCARGA_PDF', f.reg.id, 'SHA ' + sha.slice(0, 16));
  return { nombre: blob.getName() || (f.reg.id + '.pdf'), base64: Utilities.base64Encode(blob.getBytes()), huella: sha.slice(0, 16) };
}

/**
 * SOLO ADMINISTRADORES: genera el contrato en Google Docs (Word nativo convertido: editable, con márgenes y número de página reales)
 * y se lo comparte. Es el documento oficial, sin leyendas. Requiere el servicio avanzado "Drive API".
 */
function APS_docEditable(id) {
  var u = APS_requiereAdmin_(), f = APS_buscar_(id);
  if (!f) throw new Error('No se encontró el registro.');
  var datos = JSON.parse(f.reg.json);
  var archivo = APS_docDesdeDocx_(datos, APS_nombrePdf_(f.reg, datos), '');
  try { archivo.addEditor(u.email); } catch (e) { Logger.log('No se pudo compartir el documento: ' + e.message); }
  APS_audit_('APS', 'COPIA_DOCS', f.reg.id, archivo.getUrl());
  var url = archivo.getUrl();
  APS_conLock_(function () {                                     // se anota en el registro: la coordinación ve "Docs generado"
    var f2 = APS_buscar_(id);
    if (f2) { f2.reg.docUrl = url; f2.reg.docFecha = APS_ahora_(); APS_escribir_(f2.hoja, f2.fila, f2.reg); }
  });
  return { url: url };
}

/* ═════════════ PRUEBAS (ejecutar desde el editor) ═════════════ */

var APS_DOCX_MIME = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
/** Logo (PNG) en base64, leído de Drive; '' si no está disponible. */
function APS_logoBase64_() {
  var m = /^data:image\/png;base64,(.+)$/.exec(APS_logoDataUri_() || '');
  return m ? m[1] : '';
}
/** Word (.docx) NATIVO del contrato: A4, márgenes de 20 mm, tablas al ancho de la hoja, encabezado, pie y número de página reales. */
function APS_docxBlob_(datos, nombre, marca) {
  var r = APS_nucleo_().X.docx(datos, { logoBase64: APS_logoBase64_(), marca: marca || '' });
  var blobs = Object.keys(r.xml).map(function (k) { return Utilities.newBlob(r.xml[k], 'text/xml', k); });
  Object.keys(r.media).forEach(function (k) { blobs.push(Utilities.newBlob(Utilities.base64Decode(r.media[k]), 'image/png', k)); });
  return Utilities.zip(blobs, nombre + '.docx').setContentType(APS_DOCX_MIME);
}
/**
 * Sube el Word a Drive convirtiéndolo en Google Doc (editable, con la misma estructura y márgenes).
 * REQUIERE el servicio avanzado "Drive API" (editor → Servicios ＋ → Drive API, versión v3).
 */
function APS_docDesdeDocx_(datos, nombre, marca) {
  if (typeof Drive === 'undefined') throw new Error('Falta activar el servicio avanzado "Drive API" (Servicios ＋ → Drive API → v3).');
  var f = Drive.Files.create({ name: nombre, mimeType: 'application/vnd.google-apps.document', parents: [APS_ids_().carpeta] }, APS_docxBlob_(datos, nombre, marca));
  return DriveApp.getFileById(f.id);
}

/**
 * PRUEBA CLAVE: ¿qué tan bien convierte Apps Script el documento a PDF? Compara 3 métodos con 2 ejemplos:
 *   _modoNormal   → HTML directo a PDF (pie fijo)         _modoServidor → HTML directo a PDF (pie en el flujo)
 *   _viaDocx      → Word nativo → Google Doc → PDF (márgenes y número de página reales)   [requiere "Drive API"]
 * Deja en la carpeta de Drive los PDF (y el Doc de cada ejemplo, y el HTML para abrirlo en Chrome y comparar).
 * Revisa: tamaño de página (A4 vs Carta), MÁRGENES, encabezado/pie, grises, tablas, saltos de página y firmas.
 */
function APS_probarPDF() {
  APS_soloMantenimiento_();
  var N = APS_nucleo_(), carpeta = DriveApp.getFolderById(APS_ids_().carpeta);
  var casos = [['B', 'Prueba_Venta_y_Renta_2_propietarios'], ['D', 'Prueba_Venta_3_propietarios_mixto']];
  casos.forEach(function (c) {
    var datos = N.M.ejemplos[c[0]]();
    carpeta.createFile(Utilities.newBlob(APS_htmlDocumento_(datos, false), 'text/html', c[1] + '.html'));
    [false, true].forEach(function (servidor) {
      var nombre = c[1] + (servidor ? '_modoServidor' : '_modoNormal');
      try { Logger.log(nombre + ' → ' + carpeta.createFile(APS_pdfBlob_(datos, nombre, servidor)).getUrl()); }
      catch (e) { Logger.log(nombre + ' → ERROR: ' + e.message); }
    });
    try {
      var doc = APS_docDesdeDocx_(datos, c[1] + '_viaDocx', '');
      var pdf = carpeta.createFile(doc.getAs('application/pdf').setName(c[1] + '_viaDocx.pdf'));
      Logger.log(c[1] + '_viaDocx → PDF: ' + pdf.getUrl() + ' | Doc: ' + doc.getUrl());
    } catch (e) { Logger.log(c[1] + '_viaDocx → NO SE PUDO: ' + e.message); }
  });
  Logger.log('Listo. Revisa la carpeta: ' + carpeta.getUrl());
}

/** Prueba rápida de que el núcleo carga bien en el servidor y valida los ejemplos. */
function APS_probarNucleo() {
