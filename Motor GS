  var tipo = tipos[r.tipo] ? r.tipo : 'otro', msg = limpia(r.mensaje, 1500);
  if (msg.length < 10) throw new Error('Cuéntanos un poco más: escribe al menos 10 caracteres.');
  var cache = CacheService.getScriptCache(), llave = 'APS_REP_' + u.email;
  if (cache.get(llave)) throw new Error('Ya enviaste un reporte hace un momento. Espera un minuto para mandar otro.');
  var pantalla = limpia(r.pantalla, 80) || 'Pantalla principal', tec = (r.tecnico && typeof r.tecnico === 'object') ? r.tecnico : {};
  var tecTxt = limpia(JSON.stringify(tec), 1800), nombre = u.nombre || u.email;
  var folio = 'REP-' + Utilities.formatDate(new Date(), APS_CONFIG.ZONA, 'yyMMdd') + '-' + Utilities.getUuid().replace(/-/g, '').slice(0, 4).toUpperCase();
  var sh = APS_hojaAux_('Reportes', APS_REP_COLS), fila = sh.getLastRow() + 1;
  if (fila > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), 200);
