  try { cache.put(llave, '1', 60); } catch (e) { /* sin caché: no hay límite por minuto, no pasa nada */ }
  APS_audit_('SOPORTE', 'REPORTE', folio, tipos[tipo] + ' · ' + pantalla + ': ' + msg.slice(0, 120));
  var h = APS_escHtml_;
  var datos = [['Folio', folio], ['Tipo', tipos[tipo]], ['Pantalla', pantalla], ['Quién', nombre + ' · ' + u.email + ' · ' + (u.rol === 'coordinador' ? 'Coordinación' : 'Asesor')],
    ['Navegador', limpia(tec.navegador, 120)], ['Tamaño de pantalla', limpia(tec.ventana, 40)], ['Hora del equipo', limpia(tec.hora, 40)], ['Errores recientes', limpia(tec.errores, 400)]];
  APS_notificar_(APS_CONFIG.REPORTES_CORREOS, tipos[tipo] + ' — ' + pantalla + ' (' + folio + ')',
    '<b>' + h(nombre) + '</b> reportó lo siguiente:<div style="margin:12px 0 0;padding:13px 15px;background:#f4f7fc;border-radius:10px;white-space:pre-wrap;color:#1a224a">' + h(msg) + '</div><p style="margin:12px 0 0;font-size:12.5px;color:#5a6488">Para contestarle, usa «Responder»: el correo le llega a ' + h(u.email) + '.</p>',
