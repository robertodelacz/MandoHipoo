function APS_usuario_() {
  var email = APS_correo_();
  var info = email ? APS_asesores_()[email] : null;      // una sola lectura (con caché de segundos) de la hoja: de ahí salen nombre, género Y si es coordinador
  // "Coordinador" por CUALQUIERA de dos caminos: 1) el arreglo COORDINADORES de aquí abajo (fijo: quitar a alguien
  // de ahí exige publicar una versión nueva, Implementar → Administrar implementaciones → Nueva versión); o
  // 2) la columna "Rol"/"Coordinador" de la pestaña "Asesores" (en vivo: quitarlo de la hoja basta, sin publicar nada,
  // igual que dar de baja a alguien en el panel de Accesos de LPB — se refleja en su siguiente operación).
  var coord = APS_CONFIG.COORDINADORES.some(function (x) { return String(x).toLowerCase() === email; }) || !!(info && info.coordinador);
  var nombre = info ? info.nombre : '';
  var genero = (info && info.genero) || APS_generoNombre_(nombre);       // primero lo explícito (columna "Género"), si no hay, se adivina
  // "pdf" ya no es un permiso de todo-o-nada: el coordinador siempre puede; el asesor solo lo sabrá contrato por
  // contrato (ver accionesHtml() en el cliente y el candado real en APS_obtenerPdf() del servidor).
  return { email: email, nombre: nombre, genero: genero, rol: coord ? 'coordinador' : 'asesor', pdf: coord, puedeAps: !!email && (coord || !!info) };
}
/* Nombres femeninos frecuentes que NO terminan en "a" (la heurística por defecto solo acertaría los que sí). Lista
 * corta, pensada para México; no pretende cubrir todos los nombres. */
var APS_NOMBRES_F_ = ('lizbeth elizabeth isabel carmen miriam ruth esther raquel abigail ingrid beatriz itzel ' +
  'soledad mercedes pilar nayeli dulce nancy jazmin marisol consuelo cristel ivon sarai noemi belen anahi ' +
  'guillermina esperanza montserrat maite estefani estefany jimena mayte yamile aime nicte citlali xochitl').split(' ')
  .reduce(function (o, n) { o[n] = 1; return o; }, {});
/* Nombres que, aunque terminan en "a", son de uso masculino (para no marcarlos como femeninos por la heurística). */
var APS_NOMBRES_M_ = 'luca noe jonathan matias tobias elias isaias jeremias zacarias'.split(' ').reduce(function (o, n) { o[n] = 1; return o; }, {});
/* Nombres de uso frecuente para ambos sexos en México: mejor no adivinar que adivinar mal. */
var APS_NOMBRES_AMBIGUOS_ = 'guadalupe trinidad rosario cruz angel refugio candelaria remedios socorro'.split(' ').reduce(function (o, n) { o[n] = 1; return o; }, {});
/**
 * Adivina el género del primer nombre para conjugar "Bienvenido"/"Bienvenida" — 'm' | 'f' | '' (no se sabe: el saludo
 * cae entonces en "Bienvenido/a"). Nunca es infalible; por eso, si hay duda razonable (nombre ambiguo o muy corto),
 * prefiere no adivinar. La columna "Género" del archivo de asesores (ver APS_parseAsesores_) siempre tiene prioridad
 * sobre esta heurística cuando está presente.
 */
function APS_generoNombre_(nombre) {
  var primero = String(nombre || '').trim().split(/\s+/)[0];
  if (!primero || primero.length < 3) return '';
  var k = primero.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  if (APS_NOMBRES_AMBIGUOS_[k]) return '';
  if (APS_NOMBRES_F_[k]) return 'f';
  if (APS_NOMBRES_M_[k]) return 'm';
  return /a$/.test(k) ? 'f' : 'm';
}
var APS_RE_CORREO_ = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
/** Lee una tabla (matriz) y devuelve { correo: {nombre} }. Detecta el encabezado ("Correo"/"Email"), y omite a quien tenga Activo = NO. */
function APS_parseAsesores_(filas) {
  var res = {}, hdr = -1, cCorreo = -1, cNombre = -1, cActivo = -1, cGenero = -1, cRol = -1, i, j;
  if (!filas || !filas.length) return res;
  for (i = 0; i < Math.min(filas.length, 5) && hdr < 0; i++) {
    for (j = 0; j < filas[i].length; j++) { if (/^(correo|e-?mail|mail|usuario)/.test(String(filas[i][j]).toLowerCase().trim())) { cCorreo = j; hdr = i; break; } }
  }
  if (hdr >= 0) {
    filas[hdr].forEach(function (v, k) {
      var t = String(v).toLowerCase().trim();
      if (/^nombre/.test(t)) cNombre = k;
      if (/^(activo|estatus|estado|vigente)/.test(t)) cActivo = k;
      if (/^(genero|género|sexo|trato)/.test(t)) cGenero = k;
      if (/^(rol|tipo|perfil|coordinador)/.test(t)) cRol = k;
    });
  } else {
    var cuenta = {}, mejor = -1;
    filas.forEach(function (fila) { fila.forEach(function (v, k) { if (APS_RE_CORREO_.test(String(v).trim())) cuenta[k] = (cuenta[k] || 0) + 1; }); });
    Object.keys(cuenta).forEach(function (k) { if (mejor < 0 || cuenta[k] > cuenta[mejor]) mejor = k; });
    if (mejor < 0) return res;
    cCorreo = Number(mejor);
  }
  for (i = hdr + 1; i < filas.length; i++) {
    var em = String(filas[i][cCorreo] === undefined ? '' : filas[i][cCorreo]).toLowerCase().trim();
    if (!APS_RE_CORREO_.test(em)) continue;
    if (cActivo >= 0 && /^(no|n|0|false|falso|baja|inactivo|inactiva)$/i.test(String(filas[i][cActivo]).trim())) continue;
    var g = cGenero >= 0 ? String(filas[i][cGenero]).trim().toLowerCase() : '';                 // columna "Género" opcional: M/F, Hombre/Mujer, Sr./Sra., etc.
    var esF = /^(f|mujer|fem|sra\.?|srita\.?|señora)/.test(g);                                   // se revisa primero "femenino": "mujer" también empieza con "m"
    var rolTxt = cRol >= 0 ? String(filas[i][cRol]).trim().toLowerCase() : '';                  // columna "Rol"/"Coordinador" opcional: "Coordinador"/"Admin", o "Sí"/"X" si la columna ya se llama "Coordinador"
    res[em] = { nombre: cNombre >= 0 ? String(filas[i][cNombre]).trim() : '',
      genero: esF ? 'f' : (/^(m|h|masc|hombre|sr\.?|señor)/.test(g) ? 'm' : ''),
      coordinador: /coord|admin|^(si|sí|s|x|1|true|yes)$/.test(rolTxt) };
  }
  return res;
}
/** Lee el archivo externo (ASESORES_HOJA_ID) y la pestaña interna "Asesores" — mismo criterio que el panel de Accesos
 * de LPB: quitar (o dar de baja, columna "Activo") a un asesor O a un coordinador en la hoja se refleja en su
 * siguiente operación, sin publicar nada. Con un caché de unos segundos (ver APS_ASESORES_CACHE_SEG) para evitar
 * que varias llamadas casi simultáneas abran la hoja al mismo tiempo — eso fue lo que causó que la pantalla se
 * quedara cargando la primera vez que alguien entraba a una sección. */
/** Caché MUY corto (segundos, no minutos) para la lectura de la hoja de asesores. No es para "esperar a que se
 * refresque" — es solo para que, cuando la página dispara varias llamadas casi juntas (por ejemplo, al entrar a una
 * sección), no se abra la hoja de Google una vez POR CADA llamada al mismo tiempo — eso fue lo que provocó que la
 * pantalla se quedara cargando la primera vez. Dar de baja a alguien se sigue notando en cuestión de segundos, sin
 * publicar nada; ya no es "al instante exacto", pero es un precio pequeño a cambio de que la página no se cuelgue. */
var APS_ASESORES_CACHE_SEG = 8;
function APS_asesores_() {
  var cache = CacheService.getScriptCache(), c = cache.get('APS_ASESORES');
  if (c) { try { return JSON.parse(c); } catch (e) { /* se recalcula */ } }
  var mapa = {}, une = function (m) { Object.keys(m).forEach(function (k) { mapa[k] = m[k]; }); };
  (APS_CONFIG.ASESORES_AUTORIZADOS || []).forEach(function (e) { var k = String(e).toLowerCase().trim(); if (APS_RE_CORREO_.test(k)) mapa[k] = { nombre: '', coordinador: false }; });
  try {
    if (APS_CONFIG.ASESORES_HOJA_ID) {
      var ss = SpreadsheetApp.openById(APS_CONFIG.ASESORES_HOJA_ID);
      var sh = APS_CONFIG.ASESORES_HOJA_NOMBRE ? ss.getSheetByName(APS_CONFIG.ASESORES_HOJA_NOMBRE) : ss.getSheets()[0];
      if (sh && sh.getLastRow() > 0) une(APS_parseAsesores_(sh.getDataRange().getValues()));
    }
  } catch (e) { Logger.log('No se pudo leer el archivo de asesores autorizados: ' + e.message); }
  try {
    var pr = PropertiesService.getScriptProperties().getProperty('APS_HOJA_ID');
    if (pr) { var interna = SpreadsheetApp.openById(pr).getSheetByName('Asesores'); if (interna && interna.getLastRow() > 0) une(APS_parseAsesores_(interna.getDataRange().getValues())); }
  } catch (e) { Logger.log('No se pudo leer la pestaña Asesores: ' + e.message); }
  try { cache.put('APS_ASESORES', JSON.stringify(mapa), APS_ASESORES_CACHE_SEG); } catch (e) { /* sin caché: no pasa nada, solo se vuelve a leer la próxima vez */ }
  return mapa;
}
/** TODA la coordinación: el arreglo fijo COORDINADORES + quien tenga Rol "Coordinador" en la hoja Asesores. Úsala para correos y permisos de Drive. */
function APS_coordinadores_() {
  var lista = {};
  (APS_CONFIG.COORDINADORES || []).forEach(function (c) { var k = String(c).toLowerCase().trim(); if (k) lista[k] = 1; });
  var mapa = {}; try { mapa = APS_asesores_(); } catch (e) { mapa = {}; }
