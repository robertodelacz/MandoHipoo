#aps-root .modal-stage{position:relative;margin:0 auto}
@media(max-width:600px){#aps-root .app{padding:20px 12px 50px}#aps-root .card{padding:18px;box-shadow:5px 5px 0 rgba(0,0,0,.5)}#aps-root .hdr h1{font-size:30px}#aps-root .row-item{flex-direction:column;align-items:stretch}#aps-root .btn-mini{align-self:flex-start}}
#aps-root .userbar{display:flex;align-items:center;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-bottom:10px}
#aps-root .userbar .btn-sec{padding:8px 14px;font-size:12px}
