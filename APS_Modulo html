#aps-root .est{font-size:11px;font-weight:800;padding:3px 9px;border-radius:999px;border:2px solid var(--border-dark)}
#aps-root .est.e-BORRADOR,#aps-root .est.e-SIN_TERMINAR{background:#cbd5e1;color:#1e293b}
#aps-root .est.e-COMPLETO{background:#7dd3fc;color:#0c2a3d}
