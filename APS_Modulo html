    var b = $('aps_estado'); b.className = 'badge ' + (ISS.length ? 'warn' : 'ok'); b.textContent = ISS.length ? 'Borrador · ' + ISS.length + ' pendiente' + (ISS.length === 1 ? '' : 's') : 'Completo';
    if ($('aps_modal').classList.contains('open')) { $('aps_modalPaper').innerHTML = h; fitModal(); }
    fitPreview();
  }
  function fitPreview() {
    var sc = $('aps_pvScroll'), sizer = $('aps_pvSizer'), paper = $('aps_pvPaper');
    var w = sc.clientWidth - 20; if (w < 200) return;
    var s = w / 794; paper.style.transform = 'scale(' + s + ')';
    sizer.style.width = (794 * s) + 'px'; sizer.style.height = (paper.offsetHeight * s) + 'px';
  }
  function fitModal() {
    var stage = $('aps_modalStage'), paper = $('aps_modalPaper'), w = Math.min(window.innerWidth - 32, 900), s = w / 794;
    paper.style.transform = 'scale(' + s + ')'; stage.style.width = (794 * s) + 'px'; stage.style.height = (paper.offsetHeight * s) + 'px';
  }
  function renderPend() {
    var h = '';
    if (!ISS.length) h = '<div class="ok-line">✓ Documento completo. Listo para imprimir o guardar como PDF.</div>';
    else {
      h = '<div class="bad-line">Faltan ' + ISS.length + ' dato' + (ISS.length === 1 ? '' : 's') + ':</div>' + ISS.slice(0, 6).map(function (x) {
        return '<button type="button" data-goto="' + x.step + '" data-focus="' + x.k + '">• ' + esc(x.msg) + '</button>'; }).join('') +
        (ISS.length > 6 ? '<div class="help">…y ' + (ISS.length - 6) + ' más</div>' : '');
    }
    $('aps_pend').innerHTML = h;
  }
  function refresh(struct) {
    if (visible().indexOf(STEP) < 0) STEP = 'operacion';
    ISS = D.validar(S);
    if (struct) renderStep(); else { updateHints(); paintNav(); paintInvalid(); }
    var bn = REG && document.getElementById('aps_estadoBanner'); if (bn) { bn.className = claseBanner(); bn.innerHTML = textoBanner(); }      // el estado (sin terminar / completado) se actualiza al escribir
    renderPreview(); renderPend();
  }

  /* ── acciones ── */
  function goStep(id, focusKey) {
    STEP = id; refresh(true); window.scrollTo({ top: 0, behavior: 'smooth' });
    if (focusKey) setTimeout(function () { var el = ROOT.querySelector('#aps_stepHost [data-k="' + focusKey + '"], #aps_stepHost [data-seg="' + focusKey + '"], #aps_stepHost [data-multi="' + focusKey + '"]'); if (el) { try { el.focus(); } catch (e) {} el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } }, 60);
  }
  function next() {
    var v = visible(), idx = v.indexOf(STEP);
    if (ISS.some(function (x) { return x.step === STEP; })) {
      showErr[STEP] = true; refresh(true);
      var first = ROOT.querySelector('#aps_stepHost .invalid'); if (first) first.scrollIntoView({ block: 'center', behavior: 'smooth' });
      var m = document.createElement('div'); m.className = 'msg-step'; m.textContent = 'Faltan datos en este paso (marcados en rojo). Complétalos para continuar.';
      $('aps_stepHost').insertBefore(m, $('aps_stepHost').firstChild); return;
    }
    if (idx < v.length - 1) goStep(v[idx + 1]);
  }
  function prev() { var v = visible(), idx = v.indexOf(STEP); if (idx > 0) goStep(v[idx - 1]); }
  function tieneDatos(p) { return ['nombre', 'rfc', 'idDoc', 'rfcRep'].some(function (k) { return String(p[k] || '').trim(); }); }
  function setCount(c) {
    var cur = S.propietarios.length;
    if (c > cur) { while (S.propietarios.length < c) S.propietarios.push(newProp()); }
    else if (c < cur) {
      if (S.propietarios.slice(c).some(tieneDatos) && !window.confirm('Se quitarán los datos de ' + (cur - c) + ' propietario(s) (los últimos). ¿Continuar?')) return;
      S.propietarios.length = c;
    }
    refresh(true);
  }

  /* Página completa e independiente del documento (se imprime dentro de un iframe: así no le afecta el scroll ni los estilos de la interfaz) */
  function paginaImprimible() {
    return '<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><title>APS Hipoo</title><style>html,body{margin:0;background:#fff}' + D.css() + '</style></head><body>' + docHtml() + '<script>' + D.ajusteJS + '<\/script></body></html>';
  }
  function nombreArchivo() {
    var p = S.propietarios[0] || {}, base = String(p.nombre || '').replace(/[\\\/:*?"<>|]/g, '').trim();
    return 'APS Hipoo' + (base ? ' - ' + base : '');
  }
  function imprimir() {
    if (!puedeImprimir()) { toast('El PDF solo lo obtiene la coordinación.', true); return; }
    if (ISS.length && !window.confirm('Hay ' + ISS.length + ' dato(s) pendiente(s). El documento se imprimirá con la marca BORRADOR. ¿Continuar?')) return;
    var t0 = document.title, fr = document.createElement('iframe'), hecho = false;
    fr.setAttribute('aria-hidden', 'true'); fr.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden';
    document.body.appendChild(fr);
    function limpia() { document.title = t0; if (fr.parentNode) fr.parentNode.removeChild(fr); }
    try {
      var w = fr.contentWindow, d = w.document; d.open(); d.write(paginaImprimible()); d.close();
      w.onafterprint = limpia; setTimeout(limpia, 120000);
      var imgs = [].slice.call(d.images);
      function ir() { if (hecho) return; hecho = true; try { document.title = nombreArchivo(); w.focus(); w.print(); } catch (e) { limpia(); toast('No se pudo abrir la impresión desde aquí. Usa el PDF aprobado.', true); } }
      function listo() { if (imgs.every(function (i) { return i.complete; })) setTimeout(ir, 150); }
      if (imgs.every(function (i) { return i.complete; })) setTimeout(ir, 300);
      else { imgs.forEach(function (i) { i.addEventListener('load', listo); i.addEventListener('error', listo); }); setTimeout(ir, 5000); }   // espera el logo (máx. 5 s)
    } catch (e) { limpia(); toast('No se pudo abrir la impresión desde aquí. Usa el PDF aprobado.', true); }
  }
  function openModal() { $('aps_modal').classList.add('open'); $('aps_modalPaper').innerHTML = docHtml(); fitModal(); }
  function closeModal() { $('aps_modal').classList.remove('open'); }

  var EJ = M.ejemplos;
  function cargar(id) { S = id ? EJ[id]() : defaults(); showErr = {}; STEP = id ? 'firma' : 'operacion'; refresh(true); }


  /* ── capa Apps Script (solo si corre dentro de la aplicación web) ── */
  function toast(msg, error) {
    var t = $('aps_toast'); t.textContent = msg; t.className = 'toast show' + (error ? ' err' : '');
    clearTimeout(toast._t); toast._t = setTimeout(function () { t.className = 'toast'; }, error ? 7000 : 3000);
  }
  function busy(on, txt) { $('aps_busy').className = 'busy' + (on ? ' on' : ''); if (txt) $('aps_busyTxt').textContent = txt; }
  /* Nunca se queda "cargando" para siempre: si el servidor no contesta en 25 s, se libera la pantalla sola, con
     aviso para reintentar — sin tener que refrescar la página. */
  function srv(fn, args, ok, txt) {
    if (!IN_GAS) { toast('Esta función solo está disponible dentro de la aplicación de Apps Script.', true); return; }
    busy(true, txt || 'Procesando…');
    var listo = false;
    var vencido = setTimeout(function () { if (listo) return; listo = true; busy(false); toast('El servidor está tardando más de lo normal. Vuelve a intentarlo.', true); }, 25000);
    var r = google.script.run
      .withSuccessHandler(function (res) { if (listo) return; listo = true; clearTimeout(vencido); busy(false); if (ok) ok(res); })
      .withFailureHandler(function (err) { if (listo) return; listo = true; clearTimeout(vencido); busy(false); toast(String((err && err.message) || err).replace(/^Error:\s*/, ''), true); });
    r[fn].apply(r, args);
  }
  function normaliza(d) {
    var base = defaults(), o = Object.assign(base, d || {});
    o.propietarios = (d && d.propietarios && d.propietarios.length ? d.propietarios : [newProp()]).map(function (p) { return Object.assign(newProp(), p); });
    o.contactoDir = Object.assign(M.newDir(), o.contactoDir || {});
    if (!o.inmDomicilio && o.inmDir && o.inmDir.calle) o.inmDomicilio = U.direccion(o.inmDir);   // registros de antes de este campo (dirección ya estructurada)
    delete o.inmDir; delete o.inmMismoDomicilio;
    if (d && d.domicilioNotif && !o.contactoDir.calle) o.contactoDir.calle = String(d.domicilioNotif);
    if (!Array.isArray(o.ajustes)) o.ajustes = [];
    return o;
  }
  function conRegistro(meta) { REG = meta; renderStep(); renderPend(); renderPreview(); }
  function guardar(despues) {
    srv('APS_guardar', [S, REG ? REG.id : null], function (meta) { conRegistro(meta); if (despues) despues(meta); else toast('Borrador guardado · ' + meta.id); }, 'Guardando…');
  }
  function enviar() {
    if (ISS.length) { toast('Completa los datos pendientes antes de enviar.', true); return; }
    if (!window.confirm('¿Enviar a revisión del coordinador? Ya no podrás editarlo salvo que te lo devuelva.')) return;
    guardar(function (meta) { srv('APS_enviarRevision', [meta.id], function (m) { conRegistro(m); toast('Enviado a revisión · ' + m.id); }, 'Enviando a revisión…'); });
  }
  function aprobar() {
    if (ISS.length) { toast('Completa los datos pendientes antes de aprobar.', true); return; }
    if (!window.confirm('¿Aprobar y generar el PDF definitivo? Después ya no se puede editar.')) return;
    guardar(function (meta) { srv('APS_aprobar', [meta.id], function (m) { conRegistro(m); toast('Aprobado · PDF generado'); if (window.APS_refrescarPendientes) window.APS_refrescarPendientes(); }, 'Generando PDF…'); });
  }
  function descargar() {
    srv('APS_obtenerPdf', [REG.id], function (r) {
      var a = document.createElement('a'); a.href = 'data:application/pdf;base64,' + r.base64; a.download = r.nombre; document.body.appendChild(a); a.click(); document.body.removeChild(a);
      toast('Descarga iniciada: ' + r.nombre);
    }, 'Preparando PDF…');
  }
  function copiaDocs() {
    function crear(id) {
      srv('APS_docEditable', [id], function (r) { window.open(r.url, '_blank', 'noopener'); toast('Documento generado en Google Docs.'); }, 'Generando el documento en Google Docs…');
    }
    if (REG) { crear(REG.id); return; }
    guardar(function (meta) { crear(meta.id); });          // registro nuevo: se guarda como borrador y de inmediato se crea la copia
  }
  function clonar() { REG = null; S.fecha = M.hoyISO(); showErr = {}; STEP = 'operacion'; refresh(true); toast('Nuevo registro basado en el anterior (sin guardar).'); }
  function eliminar() {
    if (!REG) return;
    if (!window.confirm('¿Eliminar el contrato ' + REG.id + ' de forma permanente? Esto no se puede deshacer.')) return;
    srv('APS_eliminar', [REG.id], function () { toast('Contrato eliminado.'); S = defaults(); REG = null; showErr = {}; STEP = 'operacion'; refresh(true); }, 'Eliminando…');
  }
  function nuevo() {
    if (!window.confirm('¿Empezar un registro nuevo? Se descartan los cambios no guardados.')) return;
    S = defaults(); REG = null; showErr = {}; STEP = 'operacion'; refresh(true);
  }
  function abrirRegistro(id) {
    srv('APS_abrir', [id], function (r) { S = normaliza(r.datos); REG = r.meta; showErr = {}; STEP = 'firma'; cerrarRegistros(); refresh(true); }, 'Abriendo…');
  }
  var regFiltro = 'mios';
  function abrirRegistros(f) {
    regFiltro = f || (USER.rol === 'coordinador' ? 'revision' : 'mios');
    $('aps_regModal').classList.add('open');
    var tabs = USER.rol === 'coordinador' ? [['revision', 'Por revisar'], ['todos', 'Todos'], ['mios', 'Míos']] : [['mios', 'Mis registros']];
    $('aps_regTabs').innerHTML = tabs.map(function (t) { return '<button type="button" class="chip' + (t[0] === regFiltro ? ' active' : '') + '" data-regtab="' + t[0] + '">' + t[1] + '</button>'; }).join('');
    $('aps_regList').innerHTML = '<div class="help">Cargando…</div>';
    srv('APS_listar', [regFiltro], function (rows) {
      $('aps_regList').innerHTML = rows.length ? '<div class="reg-wrap"><table class="reg"><thead><tr><th>ID</th><th>Estado</th><th>Propietarios</th><th>Tipo</th><th>Actualizado</th>' + (USER.rol === 'coordinador' ? '<th>Asesor</th>' : '') + '<th></th></tr></thead><tbody>' +
        rows.map(function (r) { return '<tr><td>' + esc(r.id) + '</td><td><span class="est e-' + (r.estadoUI || r.estado) + '">' + (ESTADOS_UI[r.estadoUI] || ESTADOS[r.estado]) + '</span></td><td>' + esc(r.propietarios) + '</td><td>' + esc(r.tipo) + '</td><td>' + esc(r.actualizado) + '</td>' +
          (USER.rol === 'coordinador' ? '<td>' + esc(r.asesor) + '</td>' : '') + '<td><button type="button" class="btn-mini" data-open="' + esc(r.id) + '">Abrir</button></td></tr>'; }).join('') + '</tbody></table></div>'
        : '<div class="help">No hay registros en esta vista.</div>';
    }, 'Cargando registros…');
  }
  function cerrarRegistros() { $('aps_regModal').classList.remove('open'); }
  function iniciarServidor() {
    if (!IN_GAS) return;
    $('aps_userbar').style.display = 'flex';
    srv('APS_iniciar', [], function (r) {
      USER = r.usuario;
      if (USER.rol === 'coordinador') ROOT.querySelector('.ejs').style.display = '';
      var pi = puedeImprimir(); $('aps_btnPrint').style.display = pi ? '' : 'none'; $('aps_modalPrint').style.display = pi ? '' : 'none';
      $('aps_userChip').textContent = USER.email ? USER.email + ' · ' + (USER.rol === 'coordinador' ? 'Coordinador' : 'Asesor') : 'Sin identificar';
      if (r.logo) {
        D.CFG.logoSrc = r.logo;
        var li = ROOT.querySelector('.logo-img'); if (li) { li.src = r.logo; li.style.display = 'block'; if (li.nextElementSibling) li.nextElementSibling.style.display = 'none'; }
      }
      if (!USER.email) { $('aps_stepHost').innerHTML = '<div class="card"><div class="msg-step">No se pudo identificar tu cuenta de Google. Abre el enlace con tu cuenta corporativa (Cualli o Hipoo) y vuelve a intentar.</div></div>'; $('aps_btnNext').style.display = 'none'; return; }
      refresh(true);
    }, 'Cargando…');
  }

  /* ── eventos ── */
  var host = $('aps_stepHost');
  /* Separador de miles EN VIVO mientras se escribe (sin esperar a salir del campo). Solo agrupa dígitos con comas;
     los 2 decimales se completan al salir del campo (ver focusout), para no estorbar mientras se sigue escribiendo. */
  function formatoMoneyVivo(v) {
    v = String(v).replace(/[^\d.]/g, '');
    var i = v.indexOf('.');
    if (i >= 0) v = v.slice(0, i + 1) + v.slice(i + 1).replace(/\./g, '');   // solo el primer punto cuenta como decimal
    var partes = v.split('.'), ent = partes[0].replace(/^0+(?=\d)/, '');
    return ent.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (partes.length > 1 ? '.' + partes[1].slice(0, 2) : '');
  }
  host.addEventListener('input', function (e) {
    var t = e.target, k = t.getAttribute && t.getAttribute('data-k'); if (!k || ro()) return;
    var v = t.value;
    if (t.getAttribute('data-upper')) { var pos = t.selectionStart; v = v.toUpperCase(); t.value = v; try { t.setSelectionRange(pos, pos); } catch (er) {} }
    if (t.getAttribute('data-digits')) { v = v.replace(/\D/g, '').slice(0, 5); t.value = v; }
    if (t.getAttribute('data-fmt') === 'money') {
      var cursor = t.selectionStart, digitosAntes = (v.slice(0, cursor).match(/\d/g) || []).length;
      v = formatoMoneyVivo(v); t.value = v;
      var i2 = 0, vistos = 0;
      while (i2 < v.length && vistos < digitosAntes) { if (/\d/.test(v[i2])) vistos++; i2++; }
      try { t.setSelectionRange(i2, i2); } catch (er) {}
    }
    setP(k, v); refresh(!!t.getAttribute('data-rerender'));
  });
  function setAjustes(n, campo) {
    var A = S.ajustes || (S.ajustes = []);
    if (n < A.length) {
      if (A.slice(n).some(function (a) { return String(a.fecha || '').trim() || String(a.monto || '').trim(); }) && !window.confirm('Se quitarán los últimos ' + (A.length - n) + ' ajuste(s) ya capturados. ¿Continuar?')) { campo.value = A.length; return; }
      A.length = n;
    } else { while (A.length < n) A.push({ fecha: '', monto: '' }); }
    campo.value = n; ROOT.querySelector('.adj-box').innerHTML = ajustesRows(); refresh(false);
  }
  host.addEventListener('change', function (e) {
    var t = e.target; if (!t.getAttribute || !t.getAttribute('data-nadj') || ro()) return;
    setAjustes(Math.max(0, Math.min(15, parseInt(t.value, 10) || 0)), t);
  });
  host.addEventListener('focusout', function (e) {
    var t = e.target;
    if (t.getAttribute && t.getAttribute('data-dir') && !ro()) {
      var libre = t.getAttribute('data-dir') === 'libre', nv = libre ? U.normDireccionLibre(t.value) : U.normDir(t.value);
      if (nv !== t.value) { t.value = nv; setP(t.getAttribute('data-k'), nv); refresh(false); }
    }
    if (t.getAttribute && t.getAttribute('data-fmt') === 'money') {
      var n = U.parseNum(t.value); if (!isNaN(n)) { t.value = U.formatoNum(n); setP(t.getAttribute('data-k'), t.value); refresh(false); } }
  });
  host.addEventListener('click', function (e) {
    var b = e.target.closest('button'); if (!b) return;
    if (ro() && !b.hasAttribute('data-keep')) return;
    if (b.hasAttribute('data-count')) { setCount(parseInt(b.getAttribute('data-count'), 10)); return; }
    if (b.hasAttribute('data-seg')) {
      var kSeg = b.getAttribute('data-seg'), vSeg = b.getAttribute('data-v');
      setP(kSeg, vSeg);
      if (/\.rfcModo$/.test(kSeg)) setP(kSeg.replace(/rfcModo$/, 'rfc'), '');      // al cambiar "Sí"/"No" el campo de RFC se limpia, para escribirlo de nuevo o dejarlo vacío
      refresh(true); return;
    }
    if (b.hasAttribute('data-multi')) {
      var k = b.getAttribute('data-multi'), v = b.getAttribute('data-v'), arr = (getP(k) || []).slice(), i = arr.indexOf(v);
      if (i >= 0) arr.splice(i, 1); else arr.push(v); setP(k, arr); refresh(true); return; }
    var a = b.getAttribute('data-act'), oi = parseInt(b.getAttribute('data-i'), 10), rj = parseInt(b.getAttribute('data-j'), 10);
    if (a === 'copiarContacto') { setP('inmDomicilio', U.direccion(S.contactoDir)); refresh(true); }
    else if (a === 'addRep' && S.propietarios[oi].representantes.length < 2) { S.propietarios[oi].representantes.push({ trato: '', nombre: '' }); refresh(true); }
    else if (a === 'delRep') { S.propietarios[oi].representantes.splice(rj, 1); refresh(true); }
    else if (a === 'print') imprimir();
    else if (a === 'zoom') openModal();
    else if (a === 'save') guardar();
    else if (a === 'submit') enviar();
    else if (a === 'approve') aprobar();
    else if (a === 'download') descargar();
    else if (a === 'clone') clonar();
    else if (a === 'docs') copiaDocs();
    else if (a === 'eliminar') eliminar();
  });
  ROOT.addEventListener('click', function (e) {
    var b = e.target.closest('[data-goto]'); if (b) { goStep(b.getAttribute('data-goto'), b.getAttribute('data-focus')); return; }
    var x = e.target.closest('[data-ej]'); if (x) { var id = x.getAttribute('data-ej'); cargar(id === 'reset' ? null : id); }
  });
  ROOT.addEventListener('click', function (e) {
    var o = e.target.closest('[data-open]'); if (o) { abrirRegistro(o.getAttribute('data-open')); return; }
    var t = e.target.closest('[data-regtab]'); if (t) abrirRegistros(t.getAttribute('data-regtab'));
  });
  $('aps_btnRegistros').addEventListener('click', function () { abrirRegistros(); });
  $('aps_btnNuevo').addEventListener('click', nuevo);
  $('aps_regClose').addEventListener('click', cerrarRegistros);
  $('aps_btnNext').addEventListener('click', next); $('aps_btnPrev').addEventListener('click', prev);
  $('aps_btnZoom').addEventListener('click', openModal); $('aps_btnPrint').addEventListener('click', imprimir);
  $('aps_modalClose').addEventListener('click', closeModal); $('aps_modalPrint').addEventListener('click', function () { closeModal(); imprimir(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && ROOT.offsetParent !== null) { closeModal(); cerrarRegistros(); } });
  window.addEventListener('resize', function () { fitPreview(); if ($('aps_modal').classList.contains('open')) fitModal(); });
  
  $('aps_docCss').textContent = D.css(null, { sinPagina: true });
  var activado = false;
  function activar() { if (!activado) { activado = true; iniciarServidor(); } refresh(true); fitPreview(); }
  window.APS_UI = { activar: activar, paginaImprimible: paginaImprimible, abrir: abrirRegistro, misRegistros: abrirRegistros, cargar: cargar, estado: function () { return S; }, pendientes: function () { return ISS.slice(); }, ir: goStep, step: function () { return STEP; } };
  if (IN_GAS) { $('aps_btnPrint').style.display = 'none'; $('aps_modalPrint').style.display = 'none'; }      // el PDF solo lo ve la coordinación (se muestran al identificar)
  if (IN_GAS) ROOT.querySelector('.ejs').style.display = 'none';       // datos de ejemplo: solo coordinador (se muestran al identificar)
  refresh(true);
})();

</script>
