  var IN_GAS = !!(typeof google !== 'undefined' && google.script && google.script.run);
  var S = defaults(), STEP = 'operacion', showErr = {}, ISS = [], REG = null, USER = { email: '', rol: 'local' };
  var ESTADOS = { BORRADOR: 'Borrador', EN_REVISION: 'En revisión', APROBADO: 'Aprobado' };
  var ESTADOS_UI = { SIN_TERMINAR: 'Guardado sin terminar', COMPLETO: 'Completado', EN_REVISION: 'En revisión', APROBADO: 'Aprobado' };
  function etiquetaEstado() { return REG.estado === 'BORRADOR' ? (ISS.length ? ESTADOS_UI.SIN_TERMINAR : ESTADOS_UI.COMPLETO + ' (sin enviar)') : ESTADOS[REG.estado]; }
  var STEP_INFO = { operacion: 'Operación', cliente: 'Propietarios', inmueble: 'Inmueble', venta: 'Venta', renta: 'Arrendamiento', firma: 'Revisión y firma' };

  var ROOT = document.getElementById('aps-root');
  function $(id) { return document.getElementById(id); }
  function getP(p) { return p.split('.').reduce(function (o, k) { return o == null ? o : o[k]; }, S); }
  function setP(p, v) { var ks = p.split('.'), o = S; for (var i = 0; i < ks.length - 1; i++) o = o[ks[i]]; o[ks[ks.length - 1]] = v; }
  function hasIssue(k) { return ISS.some(function (x) { return x.k === k; }); }
  function inv(k) { return (showErr[STEP] && hasIssue(k)) ? ' invalid' : ''; }
  function puedeImprimir() { return !IN_GAS || USER.rol === 'coordinador'; }      // el PDF y su vista de impresión: solo coordinación
  function ro() {                       // solo lectura (el servidor también lo valida)
    if (!REG) return false;
    if (REG.estado === 'APROBADO') return true;
    if (USER.rol === 'coordinador') return false;
