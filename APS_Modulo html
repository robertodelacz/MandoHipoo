#aps-root .reg-box{max-width:980px;margin:0 auto;background:var(--bg-card);border:var(--border-width) solid var(--primary);border-radius:var(--radius);padding:22px}
#aps-root .reg-box h2{font-family:'Montserrat',sans-serif;font-size:20px;margin-bottom:14px}
