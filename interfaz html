<script>
  // Lógica funcional de la interfaz conectada al Backend de Apps Script
  var config = {
    vendedorRegimen: 'PF',
    vendedorCount: 1,
    compradorRegimen: 'PF',
    compradorCount: 1,
    pagosCount: 1
  };

  function setMode(modo, btn) {
    document.querySelectorAll('.mode-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('modoNueva').style.display = (modo === 'nueva') ? '' : 'none';
    document.getElementById('modoPago').style.display = (modo === 'pago') ? '' : 'none';
    document.getElementById('modoRevision').style.display = (modo === 'revision') ? '' : 'none';
    if (modo === 'revision' && window.PLDREV) { PLDREV.cargar(); }
  }

  function setRegime(side, regime, btn) {
    var buttons = btn.parentElement.querySelectorAll('.regime-btn');
    buttons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    if (side === 'vendedor') config.vendedorRegimen = regime;
    else config.compradorRegimen = regime;
    updatePreview();
  }

  function countLimits(field) {
    return { min: 1, max: (field === 'pagos') ? 10 : 20 };
  }

  function adjustCount(field, delta) {
    var limits = countLimits(field);
    var key = field + 'Count';
    config[key] = Math.max(limits.min, Math.min(limits.max, config[key] + delta));
    document.getElementById('count' + capitalize(field)).textContent = config[key];
    updatePreview();
  }

  function clearCount(field) {
    var limits = countLimits(field);
    config[field + 'Count'] = limits.min;
    
    var el = document.getElementById('count' + capitalize(field));
    el.textContent = limits.min;
    
    bump(el);
    updatePreview();
  }

  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  function bump(el) {
    el.classList.remove('bump');
    void el.offsetWidth;
    el.classList.add('bump');
  }

  function bumpBox(el) {
    el.classList.remove('bumpBox');
    void el.offsetWidth;
    el.classList.add('bumpBox');
  }

  function updatePreview() {
    // Manejo de singulares y plurales
    var regSingular = { 'PF': 'Persona Física', 'PM': 'Persona Moral' };
    var regPlural = { 'PF': 'Personas Físicas', 'PM': 'Personas Morales' };
    
    var elVendedor = document.getElementById('prevVendedor');
    var elComprador = document.getElementById('prevComprador');
    var elPagos = document.getElementById('prevPagos');
    var elResumen = document.getElementById('resumenDetalle');
    
    // 1. Textos para los cuadros pequeños (tiles)
    var txtVendedor = config.vendedorCount + ' ' + (config.vendedorCount === 1 ? regSingular[config.vendedorRegimen] : regPlural[config.vendedorRegimen]);
    var txtComprador = config.compradorCount + ' ' + (config.compradorCount === 1 ? regSingular[config.compradorRegimen] : regPlural[config.compradorRegimen]);

    if (elVendedor.textContent !== txtVendedor) { elVendedor.textContent = txtVendedor; bump(elVendedor); }
    if (elComprador.textContent !== txtComprador) { elComprador.textContent = txtComprador; bump(elComprador); }
    if (elPagos.textContent !== String(config.pagosCount)) { elPagos.textContent = config.pagosCount; bump(elPagos); }

    // 2. Construcción del resumen textual detallado
    var vLabel = config.vendedorCount === 1 ? regSingular[config.vendedorRegimen] : regPlural[config.vendedorRegimen];
    var cLabel = config.compradorCount === 1 ? regSingular[config.compradorRegimen] : regPlural[config.compradorRegimen];
    
    var vText = config.vendedorCount + (config.vendedorCount === 1 ? ' Vendedor (' : ' Vendedores (') + vLabel + ')';
    var cText = config.compradorCount + (config.compradorCount === 1 ? ' Comprador (' : ' Compradores (') + cLabel + ')';
    var pText = config.pagosCount === 1 ? '1 pago único' : config.pagosCount + ' pagos';

    var htmlResumen = "La operación se configurará para <strong>" + vText + "</strong> y <strong>" + cText + "</strong>, liquidándose mediante <strong>" + pText + "</strong>.";

    // Actualizamos el DOM solo si cambió para disparar la animación
    if (elResumen.innerHTML !== htmlResumen) {
      elResumen.innerHTML = htmlResumen;
      bumpBox(elResumen);
    }
  }

  function resetForm() {
    document.getElementById('txtOperacion').value = '';
    document.getElementById('txtAsocLado1').value = '';
    document.getElementById('txtAsocLado2').value = '';
    
    config.vendedorRegimen = 'PF';
    config.vendedorCount = 1;
    config.compradorRegimen = 'PF';
    config.compradorCount = 1;
    config.pagosCount = 1;

    var botonesRegimen = document.querySelectorAll('.regime-btn');
    botonesRegimen.forEach(b => b.classList.remove('active'));
    
    var gruposToggle = document.querySelectorAll('.regime-toggle');
    gruposToggle.forEach(grupo => {
      grupo.querySelector('.regime-btn').classList.add('active');
    });

    document.getElementById('countVendedor').textContent = 1;
    document.getElementById('countComprador').textContent = 1;
    document.getElementById('countPagos').textContent = 1;

    updatePreview();
    
    var elStatus = document.getElementById('statusMsg');
    elStatus.style.display = 'none';
    elStatus.className = 'status'; 
    
    setTimeout(() => { elStatus.style.display = ''; }, 50); 
  }

  function generarPreAviso() {
    var operacion = document.getElementById('txtOperacion').value.trim();
    var asocL1 = document.getElementById('txtAsocLado1').value.trim();
    var asocL2 = document.getElementById('txtAsocLado2').value.trim();

    if (!operacion || !asocL1 || !asocL2) {
      showStatus('error', '⚠️ FALTA INFORMACIÓN: Debes llenar el nombre de la operación y ambos asociados responsables para continuar.');
      return;
    }
    
    showStatus('loading', '<div class="clock-spinner"></div> PROCESANDO: Generando archivo protegido...');
    document.getElementById('btnGenerar').disabled = true;

    if (typeof google !== 'undefined' && google.script) {
      google.script.run
        .withSuccessHandler(function(res) {
          document.getElementById('btnGenerar').disabled = false;
          if (res.success) {
            showStatus('success', 
              '✅ ¡LISTO! Documento generado e inscrito en Bitácora.<br>' + 
              '<a href="'+res.url+'" target="_blank">ABRIR PRE-AVISO PLD</a>' + 
              '<button type="button" class="btn-reset" onclick="PLDREV.enviar(\'' + res.id + '\', this)">📤 ENVIAR A REVISIÓN</button>' + 
              '<button onclick="resetForm()" class="btn-reset">NUEVA OPERACIÓN</button>'
            );
          } else {
            showStatus('error', '💥 ERROR: ' + res.message);
          }
        })
        .withFailureHandler(function(err) {
          document.getElementById('btnGenerar').disabled = false;
          showStatus('error', '💥 ERROR CRÍTICO: ' + err.message);
        })
        .generarPreAvisoPLD({
          operacion: operacion,
          asociadoLado1: asocL1, 
          asociadoLado2: asocL2, 
          ...config
        });
    } else {
      setTimeout(() => {
        document.getElementById('btnGenerar').disabled = false;
        showStatus('error', '💥 ENTORNO LOCAL: Script requiere ejecución desde Google Workspace.');
      }, 1500);
    }
  }

  function showStatus(type, html) {
    var el = document.getElementById('statusMsg');
    el.className = 'status ' + type;
    el.innerHTML = html;
  }

  // ── Modo: Agregar Pago a Operación Existente ──

  var cantidadPagoExtra = 1;

  function adjustCountPago(delta) {
    cantidadPagoExtra = Math.max(1, Math.min(9, cantidadPagoExtra + delta));
    document.getElementById('countPagoExtra').textContent = cantidadPagoExtra;
  }

  function clearCountPago() {
    cantidadPagoExtra = 1;
    var el = document.getElementById('countPagoExtra');
    el.textContent = 1;
    bump(el);
  }

  function agregarPago() {
    var link = document.getElementById('txtLinkOperacion').value.trim();

    if (!link) {
      showStatusPago('error', '⚠️ Pega el link o ID del documento de la operación.');
      return;
    }

    var etiquetaCarga = cantidadPagoExtra === 1
      ? 'VERIFICANDO DOCUMENTO Y AGREGANDO PAGO...'
      : 'VERIFICANDO DOCUMENTO Y AGREGANDO ' + cantidadPagoExtra + ' PAGOS...';
    showStatusPago('loading', '<div class="clock-spinner"></div> ' + etiquetaCarga);
    document.getElementById('btnAgregarPago').disabled = true;

    if (typeof google !== 'undefined' && google.script) {
      google.script.run
        .withSuccessHandler(function(res) {
          document.getElementById('btnAgregarPago').disabled = false;
          if (res.success) {
            var mensajeExito = res.cantidadAgregada === 1
              ? 'Se agregó el Pago ' + res.numeroPago + ' a la operación.'
              : 'Se agregaron los Pagos ' + res.primerNumeroPago + ' a ' + res.numeroPago + ' a la operación.';
            showStatusPago('success',
              '✅ ¡LISTO! ' + mensajeExito + '<br>' +
              '<a href="' + res.url + '" target="_blank">ABRIR DOCUMENTO</a>' +
              '<button onclick="resetPagoForm()" class="btn-reset">AGREGAR OTRO PAGO</button>'
            );
          } else {
            showStatusPago('error', '💥 ' + res.message);
          }
        })
        .withFailureHandler(function(err) {
          document.getElementById('btnAgregarPago').disabled = false;
          showStatusPago('error', '💥 ERROR CRÍTICO: ' + err.message);
        })
        .agregarPagoAOperacion(link, cantidadPagoExtra);
    } else {
      setTimeout(() => {
        document.getElementById('btnAgregarPago').disabled = false;
        showStatusPago('error', '💥 ENTORNO LOCAL: Script requiere ejecución desde Google Workspace.');
      }, 1500);
    }
  }

  function showStatusPago(type, html) {
    var el = document.getElementById('statusMsgPago');
    el.className = 'status ' + type;
    el.innerHTML = html;
  }

  function resetPagoForm() {
    document.getElementById('txtLinkOperacion').value = '';
    clearCountPago();
    var el = document.getElementById('statusMsgPago');
    el.style.display = 'none';
    el.className = 'status';
    setTimeout(() => { el.style.display = ''; }, 50);
  }

  updatePreview();
</script>

<script>
  // ── Bienvenida y navegación: el usuario elige y ve SOLO esa pantalla ──
  var USUARIO = <?!= APS_usuarioJson() ?>;
  var TABLERO_URL = <?!= APS_tableroUrlJson() ?>;      // solo trae valor si el usuario es coordinador Y ya está configurado
  var TITULOS = { pld: 'Generar documento Pre PLD', aps: 'Generar contrato APS', revpld: 'Revisión de Pre PLD', revaps: 'Revisión de contratos APS', tablero: 'Tablero Hipoo' };
  var CONTENEDOR = { pld: 'modulo-pld', aps: 'modulo-aps', revpld: 'modulo-consola', revaps: 'modulo-consola', tablero: 'modulo-tablero' };
  function hayPantalla(s) { return !!document.getElementById(CONTENEDOR[s]); }
  function irA(s) {
    if (s === 'consola') s = 'revaps';
    var destino = (s === 'inicio') ? 'pantalla-inicio' : CONTENEDOR[s];
    if (!destino || !document.getElementById(destino)) return;               // pantalla no disponible para este usuario
    ['pantalla-inicio', 'modulo-pld', 'modulo-aps', 'modulo-consola', 'modulo-tablero'].forEach(function (id) {
      var el = document.getElementById(id); if (el) { el.style.display = (id === destino) ? '' : 'none'; }
    });
    document.getElementById('barra-nav').style.display = (s === 'inicio') ? 'none' : '';
    document.getElementById('navTitulo').textContent = TITULOS[s] || '';
    document.getElementById('navUsuario').textContent = USUARIO.nombre || USUARIO.email;
    actualizaNavPend();
    window.scrollTo(0, 0);
    if (s === 'aps' && window.APS_UI) { APS_UI.activar(); }
    if (s === 'revaps' && window.CON) { CON.abrir('aps'); }
    if (s === 'revpld' && window.CON) { CON.abrir('pld'); }
    if (s === 'tablero' && window.TAB) { TAB.activar(); }
  }
  // El tablero es OTRA aplicación web de Google; Google no permite mostrarla dentro de esta página (protección propia de Google contra clickjacking).
  // Por eso el botón, cuando ya está configurado, lleva directo a su pestaña — un solo clic, sin pantalla intermedia solo para repetir el mismo botón.
  function abrirTarjeta(id) {
    if (id === 'tablero' && TABLERO_URL) { window.open(TABLERO_URL, '_blank', 'noopener'); return; }
    irA(id);
  }
  function setModulo(m) { irA(m); }
  // Insignia "🔔 N pendientes" en la barra de arriba: a diferencia del aviso de la bienvenida, esta SIGUE al
  // coordinador a cualquier pantalla (revisando un contrato, generando un Pre PLD, etc.) — no hay que volver al
  // inicio para acordarse de que algo espera revisión.
  function actualizaNavPend() {
    var el = document.getElementById('navPend'); if (!el) return;
    var pTot = (PENDIENTES.aps || 0) + (PENDIENTES.pld || 0);
    if (USUARIO.rol === 'coordinador' && pTot > 0) {
      el.style.display = ''; el.textContent = '🔔 ' + pTot + ' pendiente' + (pTot === 1 ? '' : 's');
      el.onclick = function () { irA(PENDIENTES.aps > 0 ? 'revaps' : 'revpld'); };
    } else el.style.display = 'none';
  }
  function tarjeta(id, icono, titulo, texto, o) {
    o = o || {};
    var badge = o.badge ? '<span class="badge-pend">' + (o.badge > 99 ? '99+' : o.badge) + '</span>' : '';
    var boton = '<button type="button" class="inicio-card' + (o.coord ? ' coord' : '') + (o.off ? ' off' : '') + '" data-ir="' + id + '"' + (o.off ? ' disabled' : '') + '>' + badge +
      '<div class="ic">' + icono + '</div><b>' + titulo + '</b><span>' + texto + '</span>' + (o.aviso ? '<span class="aviso">' + o.aviso + '</span>' : '') + '</button>';
    // Acceso directo y llamativo a "mis registros" de este módulo, pegado como una pestañita al pie de la tarjeta —
    // para que el asesor no tenga que entrar primero y buscar la pestaña correspondiente adentro.
    if (!o.misRegistros) return boton;
    return '<div class="inicio-card-wrap">' + boton + '<button type="button" class="inicio-misreg" data-misreg="' + id + '">📂 Ver mis registros</button></div>';
  }
  var PENDIENTES = { aps: 0, pld: 0 };      // conteo de pendientes por revisar; la coordinación lo llena al entrar (ver más abajo) — 0 = ningún aviso todavía
  function pintaInicio() {
    var host = document.getElementById('inicioTarjetas');
    if (!USUARIO.email) {
      document.getElementById('inicioQuien').textContent = 'No se pudo identificar tu cuenta';
      host.innerHTML = '<div class="inicio-pie"><span>Abre esta página con tu cuenta corporativa de Google (Cualli, Fractio o Hipoo).</span></div>'; return;
    }
    var coord = USUARIO.rol === 'coordinador', aps = USUARIO.puedeAps;
    var saludo = USUARIO.genero === 'f' ? 'Bienvenida' : (USUARIO.genero === 'm' ? 'Bienvenido' : 'Bienvenido/a');    // 'm'/'f' vienen del servidor (columna "Género" o, si no está, una adivinanza por el nombre)
    document.getElementById('inicioSaludo').textContent = USUARIO.nombre ? '¡' + saludo + ', ' + USUARIO.nombre.split(' ')[0] + '!' : '¡' + saludo + '!';
    document.getElementById('inicioQuien').textContent = USUARIO.email + (coord ? ' · Coordinación' : '');
    var h = '';
    var pAps = PENDIENTES.aps, pPld = PENDIENTES.pld, pTot = pAps + pPld;
    if (coord && hayPantalla('revaps') && pTot > 0) {          // lo primero que ve la coordinación, antes que cualquier otra cosa — siempre visible si hay algo pendiente
      h += '<div class="inicio-warn"><div class="iw-top"><span class="ic">⚠️</span><b>Tienes pendientes por revisar</b></div><div class="iw-items">' +
        (pAps ? '<button type="button" class="iw-btn" data-ir="revaps"><b>' + pAps + '</b> contrato' + (pAps === 1 ? '' : 's') + ' APS</button>' : '') +
        (pPld ? '<button type="button" class="iw-btn" data-ir="revpld"><b>' + pPld + '</b> Pre PLD</button>' : '') + '</div></div>';
    }
    h += '<h2>¿Qué deseas hacer?</h2><div class="inicio-grid">' +
      tarjeta('pld', '🛡️', 'Generar documento Pre PLD', 'Crea el Pre-Aviso PLD de una operación inmobiliaria, agrega pagos a una operación existente o consulta tus documentos.', { misRegistros: true }) +
      tarjeta('aps', '🏠', 'Generar contrato APS', 'Aviso de Prestación de Servicios de Corretaje Inmobiliario de Hipoo: captura los datos y envíalo a revisión.',
        aps ? { misRegistros: true } : { off: true, aviso: 'No tienes autorización para generar contratos APS. Solicítala a la coordinación.' }) + '</div>';
    if (coord && hayPantalla('revaps')) {
      h += '<h2>Coordinación</h2><div class="inicio-grid">' +
        tarjeta('revaps', '🗂️', 'Revisión de contratos APS', 'Estatus de cada contrato (sin terminar, completado, en revisión, aprobado), Google Docs, PDF, alertas y auditoría.', { coord: true, badge: pAps }) +
        tarjeta('revpld', '📋', 'Revisión de Pre PLD', 'Documentos enviados a revisión, quién los generó, observaciones, bitácora de modificaciones y auditoría.', { coord: true, badge: pPld }) +
        (hayPantalla('tablero') ? tarjeta('tablero', '📊', 'Tablero Hipoo', 'Indicadores de la actividad inmobiliaria.' + (TABLERO_URL ? ' Se abre en una pestaña nueva.' : ''), { coord: true }) : '') + '</div>';
    }
    host.innerHTML = h;
  }
  document.getElementById('inicioTarjetas').addEventListener('click', function (e) {
    var m = e.target.closest('[data-misreg]'); if (m) { irMisRegistros(m.getAttribute('data-misreg')); return; }
    var b = e.target.closest('button[data-ir]'); if (b && !b.disabled) { abrirTarjeta(b.getAttribute('data-ir')); }
  });
  // Desde la tarjeta de inicio: entra al módulo y, de una vez, abre la pestaña/lista de "mis registros" en vez de
  // dejar a la persona en el formulario en blanco de "nuevo registro".
  function irMisRegistros(id) {
    irA(id);
    if (id === 'aps' && window.APS_UI && APS_UI.misRegistros) APS_UI.misRegistros();
    else if (id === 'pld') { var btn = document.getElementById('btnModoRev'); if (btn) setMode('revision', btn); }
  }
  pintaInicio();
  // Enlace directo desde un correo (ej. "Registro aprobado ..."): si la URL trae ?modulo=aps&id=XXX, se abre esa
  // pantalla y ese contrato en particular de una vez, en lugar de dejar a la persona en el menú de inicio para
  // que lo busque. Si el parámetro no aplica o no hay acceso a esa pantalla, se queda en el inicio sin romper nada.
  (function () {
    try {
      var qp = new URLSearchParams(window.location.search);
      var modulo = qp.get('modulo'), id = qp.get('id');
      if (modulo && hayPantalla(modulo)) {
        irA(modulo);
        if (id && modulo === 'aps' && window.APS_UI) APS_UI.abrir(id);
      }
    } catch (e) { /* URL sin parámetros válidos: sin problema, se queda en inicio */ }
  })();
  <? if (ADM) { ?>
  // Avisa de una vez, al entrar, si hay contratos APS o Pre PLD esperando revisión, sin que la coordinación tenga que
  // abrir cada sección para enterarse. Va envuelto en el "if (ADM)" del servidor: a un asesor ni se le manda este código.
  function refrescarPendientes() {
    if (typeof google === 'undefined' || !google.script || !google.script.run) return;
    google.script.run.withSuccessHandler(function (r) {
      PENDIENTES = { aps: (r && r.aps && r.aps.EN_REVISION) || 0, pld: (r && r.pld && r.pld.EN_REVISION) || 0 };
      pintaInicio(); actualizaNavPend();
    }).withFailureHandler(function () { /* sin aviso si no se pudo consultar */ }).CONSOLA_resumen();
  }
  window.APS_refrescarPendientes = refrescarPendientes;   // con.js y APS_Modulo lo llaman tras aprobar / marcar revisado / observar, para que el número baje sin recargar la página
  refrescarPendientes();
  <? } ?>
</script>
</body>
</html>
