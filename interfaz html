    HM.recien = {}; nuevos.forEach(function (e) { HM.recien[evId(e)] = 1; });
    HM.panel = r; PENDIENTES = { aps: r.aps.enRevision || 0, pld: r.pld ? r.pld.enRevision || 0 : 0 };
    if (nuevos.length) { var e0 = nuevos[0]; hmToast(nuevos.length > 1 ? nuevos.length + ' novedades nuevas' : e0.titulo, nuevos.length > 1 ? e0.titulo + ' · ' + e0.texto : e0.texto, true); }
    pintaInicio(); actualizaNavPend();
  }
  function refrescarPanel() {
    if (typeof google === 'undefined' || !google.script || !google.script.run || !USUARIO.email || HM.cargando) return;
    HM.cargando = true;
    google.script.run.withSuccessHandler(function (r) { HM.cargando = false; aplicaPanel(r); })
      .withFailureHandler(function () { HM.cargando = false; HM.errores++; pintaLive(); }).APS_panel();
  }
  window.APS_refrescarPendientes = refrescarPanel;     // los módulos lo llaman tras guardar, enviar, aprobar o cancelar: los números cambian sin recargar
  setInterval(function () { if (!document.hidden) refrescarPanel(); }, 25000);
  setInterval(function () { if (!document.hidden && HM.panel) { pintaFeed(); } }, 30000);       // solo para que "hace 3 min" avance
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refrescarPanel(); });

  document.getElementById('pantalla-inicio').addEventListener('click', function (e) {
    var k = e.target.closest('[data-kir]');
    if (k) { var d = k.getAttribute('data-kir'); if (USUARIO.rol === 'coordinador' && hayPantalla('rev' + d)) irA('rev' + d); else irMisRegistros(d); return; }
    var m = e.target.closest('[data-misreg]'); if (m) { irMisRegistros(m.getAttribute('data-misreg')); return; }
    var ev = e.target.closest('[data-ev]'); if (ev) { abreEvento(ev.getAttribute('data-ev')); return; }
    if (e.target.id === 'hmLeer') { marcaLeidas(); return; }
    var b = e.target.closest('button[data-ir]'); if (b && !b.disabled) { abrirTarjeta(b.getAttribute('data-ir')); }
  });
  // Desde la tarjeta de inicio: entra al módulo y, de una vez, abre la pestaña/lista de "mis registros" en vez de
  // dejar a la persona en el formulario en blanco de "nuevo registro".
  function irMisRegistros(id) {
    irA(id);
    if (id === 'aps' && window.APS_UI && APS_UI.misRegistros) APS_UI.misRegistros();
    else if (id === 'pld') { var btn = document.getElementById('btnModoRev'); if (btn) setMode('revision', btn); }
  }
  pintaInicio();
  refrescarPanel();
  // Enlace directo desde un correo (ej. "Registro aprobado ..."): si la URL trae ?modulo=aps&id=XXX, se abre esa
  // pantalla y ese contrato en particular de una vez. Con ?modulo=pld&misreg=1 abre "mis Pre PLD"; con ?modulo=revpld, la revisión de Pre PLD.
  (function () {
    try {
      var qp = new URLSearchParams(window.location.search);
      var modulo = qp.get('modulo'), id = qp.get('id');
      if (modulo && hayPantalla(modulo)) {
        irA(modulo);
        if (id && modulo === 'aps' && window.APS_UI) APS_UI.abrir(id);
        if (qp.get('misreg') && (modulo === 'pld' || modulo === 'aps')) irMisRegistros(modulo);
      }
    } catch (e) { /* URL sin parámetros válidos: sin problema, se queda en inicio */ }
  })();
</script>
