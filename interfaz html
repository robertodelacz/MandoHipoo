<!DOCTYPE html>
<html lang="es">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&display=swap" rel="stylesheet">
  <style>
    :root {
      /* ── Paleta Institucional ── */
      --primary: #35B7C5;      /* Cyan Institucional */
      --bg-card: #364494;      /* Azul Institucional */
      --text-dim: #B2B2B2;     /* Gris Institucional */
      
      /* Colores de apoyo */
      --bg-dark: #1a224a;      /* Azul marino muy oscuro para el fondo */
      --bg-input: #232d61;     /* Tono intermedio para inputs */
      --text-main: #ffffff;    /* Blanco */
      --border-dark: #0d122b;  /* Azul casi negro para sombras sólidas */
      
      /* Elementos estructurales (Neo-brutalismo) */
      --border-width: 3px;
      --shadow-solid: 6px 6px 0px var(--primary);
      --shadow-solid-dark: 4px 4px 0px var(--border-dark);
      --radius: 12px;
      --transition: 0.15s ease-out;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      min-height: 100vh;
    }

    /* ── Background ── */
    .bg-video {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }

    .bg-video video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      background: #1a224a; 
    }
    .bg-overlay {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at center, transparent 0%, rgba(26, 34, 74, 0.95) 100%);
      z-index: 0;
    }

    .app-container {
      position: relative;
      z-index: 1;
      max-width: 1140px; 
      margin: 0 auto;
      padding: 40px 24px;
    }

    /* ── Header ── */
    .header {
      text-align: center;
      margin-bottom: 24px;
    }

    .logo-container {
      background: #eaeaea;
      padding: 5px 20px; 
      border-radius: 12px;
      width: fit-content; 
      margin: 0 auto 24px auto;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      display: block; 
    }

    .header-logo {
      width: 180px; 
      height: auto; 
      display: block;
    }

    .header h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: 52px;
      color: var(--primary);
      letter-spacing: 1px;
      text-shadow: 2px 2px 0px var(--border-dark);
      margin-bottom: 12px;
    }

    .header p {
      color: var(--text-main);
      font-size: 14px;
      font-weight: 600;
      background: var(--border-dark);
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      border: 1px solid var(--primary);
    }

    /* ── Selector de Modo ── */
    .mode-switch {
      display: flex;
      gap: 12px;
      max-width: 720px;
      margin: 0 auto 32px auto;
    }

    .mode-btn {
      flex: 1;
      padding: 14px 16px;
      background: var(--bg-input);
      border: 2px solid var(--text-dim);
      border-radius: 10px;
      color: var(--text-dim);
      font-family: 'Montserrat', sans-serif;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: all 0.15s ease-out;
    }

    .mode-btn:hover {
      border-color: var(--primary);
      color: #fff;
    }

    .mode-btn.active {
      background: var(--primary);
      border-color: var(--border-dark);
      color: var(--border-dark);
      box-shadow: 4px 4px 0px var(--border-dark);
      transform: translate(-1px, -1px);
    }

    /* ── ESTRUCTURA EN DOS COLUMNAS INDEPENDIENTES ── */
    .main-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    @media (min-width: 900px) {
      .main-layout {
        grid-template-columns: 1fr 390px;
        align-items: start;
      }
      .sidebar-column {
        position: sticky;
        top: 24px; 
      }
    }

    /* ── Layout modo "Agregar Pago" (una sola columna, ancho medio) ── */
    .layout-pago {
      max-width: 620px;
      margin: 0 auto;
    }

    /* ── Cards del Formulario ── */
    .card {
      background: var(--bg-card);
      border: var(--border-width) solid var(--primary);
      border-radius: var(--radius);
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 8px 8px 0px rgba(0,0,0,0.5);
      transition: transform var(--transition);
    }

    .card:hover {
      transform: translate(-2px, -2px);
      box-shadow: 10px 10px 0px rgba(0,0,0,0.6);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      border-bottom: 2px dashed rgba(53, 183, 197, 0.4);
      padding-bottom: 16px;
    }

    .icon-box {
      width: 44px;
      height: 44px;
      background: var(--primary);
      border: 2px solid var(--border-dark);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 3px 3px 0px var(--border-dark);
      flex-shrink: 0;
    }

    .icon-img {
      width: 24px; 
      height: 24px;
      object-fit: contain; 
    }

    .icon-emoji {
      font-size: 22px;
      line-height: 1;
    }

    .card-header h2 {
      font-family: 'Montserrat', sans-serif;
      font-size: 20px;
      color: #ffffff;
      text-shadow: 1px 1px 0px var(--border-dark);
    }

    .card-header .subtitle {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      color: var(--text-dim);
      display: block;
      font-weight: 500;
      margin-top: 4px;
    }

    /* ── Forms ── */
    .field-group { margin-bottom: 20px; }
    .field-group:last-child { margin-bottom: 0; }

    label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--primary);
      margin-bottom: 8px;
    }

    .input-text {
      width: 100%;
      background: var(--bg-input);
      border: 2px solid var(--text-dim);
      border-radius: 8px;
      padding: 14px 16px;
      color: white;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s;
    }

    .input-text:focus {
      outline: none;
      background: var(--bg-dark);
      border-color: var(--primary);
      box-shadow: 4px 4px 0px rgba(53, 183, 197, 0.3);
      transform: translate(-2px, -2px);
    }

    /* ── Controles ── */
    .regime-toggle {
      display: flex;
      gap: 12px;
    }

    .regime-btn {
      flex: 1;
      border: 2px solid var(--text-dim);
      background: var(--bg-input);
      padding: 12px 16px;
      border-radius: 8px;
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.1s;
    }

    .regime-btn:hover {
      border-color: var(--primary);
      color: #fff;
    }

    .regime-btn.active {
      background: var(--primary);
      border-color: var(--border-dark);
      color: var(--border-dark);
      box-shadow: 3px 3px 0px var(--border-dark);
      transform: translate(-1px, -1px);
    }

    /* ── Stepper y Botón Borrar ── */
    .stepper-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .stepper {
      display: flex;
      align-items: center;
      background: var(--bg-input);
      border: 2px solid var(--text-dim);
      border-radius: 8px;
      width: fit-content;
      overflow: hidden;
    }

    .stepper-btn {
      width: 48px;
      height: 44px;
      border: none;
      background: transparent;
      color: white;
      font-size: 22px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.1s;
    }

    .stepper-btn:hover { background: var(--primary); color: #000; }

    .stepper-value {
      width: 60px;
      text-align: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 20px;
      border-left: 2px solid var(--text-dim);
      border-right: 2px solid var(--text-dim);
      padding: 8px 0;
      color: var(--primary);
    }

    .btn-clear-count {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 48px;
      padding: 0 16px;
      background: var(--bg-input);
      border: 2px solid var(--text-dim);
      border-radius: 8px;
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-clear-count:hover {
      border-color: #ef4444; 
      color: #ef4444;
      background: var(--bg-dark);
      box-shadow: 3px 3px 0px var(--border-dark);
      transform: translate(-1px, -1px);
    }

    .btn-clear-count:active {
      transform: translate(1px, 1px);
      box-shadow: 1px 1px 0px var(--border-dark);
    }

    /* ── Acceso y Protección ── */
    .email-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
    }

    .email-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-input);
      border: 1px solid var(--text-dim);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      color: #fff;
    }

    .email-chip .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary);
      box-shadow: 0 0 5px var(--primary);
    }

    .info-note {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px;
      border-radius: 8px;
      background: rgba(53, 183, 197, 0.1);
      border-left: 4px solid var(--primary);
      font-size: 12px;
      font-weight: 500;
      color: var(--text-main);
      margin-top: 20px;
      line-height: 1.5;
    }

    .info-note .icon {
      font-size: 18px;
      flex-shrink: 0;
    }

    /* ── RESUMEN DINÁMICO TEXTUAL (Estilo Neo-brutalista) ── */
    .summary-card {
      background: var(--bg-card);
      border: var(--border-width) solid var(--primary);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: 8px 8px 0px rgba(0,0,0,0.5);
      margin-bottom: 24px;
    }

    .summary-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      border-bottom: 2px dashed rgba(53, 183, 197, 0.4);
      padding-bottom: 12px;
    }

    .summary-head h3 {
      font-family: 'Montserrat', sans-serif;
      font-size: 18px;
      color: #ffffff;
      text-shadow: 1px 1px 0px var(--border-dark);
    }

    .summary-head span {
      font-size: 11px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .summary-head span::before {
      content: '';
      width: 8px; height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 5px #10b981;
    }

    .stat-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }

    .stat-tile {
      background: var(--bg-input);
      border: 2px solid var(--text-dim);
      border-radius: 8px;
      padding: 12px;
      text-align: center;
      transition: all var(--transition);
    }

    .stat-tile:hover {
      border-color: var(--primary);
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0px var(--border-dark);
    }

    .stat-tile span {
      display: block;
      font-size: 10px;
      color: var(--text-dim);
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .stat-tile strong {
      font-family: 'Montserrat', sans-serif;
      font-size: 16px;
      color: #ffffff;
      display: inline-block; 
    }

    /* Caja del resumen en texto */
    .stat-text-summary {
      background: var(--bg-dark);
      border: 2px solid var(--text-dim);
      border-radius: 8px;
      padding: 18px 20px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--text-main);
      text-align: center;
    }

    .stat-text-summary strong {
      color: var(--primary);
      font-family: 'Montserrat', sans-serif;
      font-size: 15px;
      font-weight: 800;
    }

    /* Animación del Resumen */
    @keyframes bump {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); color: var(--primary); }
      100% { transform: scale(1); }
    }
    .bump { animation: bump 0.4s ease-out; }
    
    @keyframes bumpBox {
      0% { transform: scale(1); }
      50% { transform: scale(1.02); border-color: var(--primary); box-shadow: 4px 4px 0px var(--primary); }
      100% { transform: scale(1); }
    }
    .bumpBox { animation: bumpBox 0.4s ease-out; }

    /* ── Panel de Ayuda Fijo Abierto ── */
    .help-panel {
      background: #eef4f8; 
      border: 2px solid var(--primary);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: 6px 6px 0px rgba(0,0,0,0.4);
    }

    .help-panel h3 {
      font-family: 'Montserrat', sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: #364494; 
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .help-panel h3::before {
      content: '💡';
      font-size: 28px;
    }

    .help-panel-content {
      font-size: 15px;
      line-height: 1.6;
      color: #1a224a; 
    }

    .help-panel-content ul {
      margin-left: 18px;
      margin-top: 10px;
    }

    .help-panel-content li {
      margin-bottom: 12px;
    }

    .help-panel-content strong {
      color: #0d122b;
    }

    /* ── Botón Guía Operativa ── */
    .btn-guide {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 12px;
      padding: 12px 16px;
      background: var(--bg-input);
      border: 2px dashed var(--primary);
      color: var(--primary);
      font-family: 'Montserrat', sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.2s ease-out;
      width: 100%;
      box-sizing: border-box;
    }
    
    .btn-guide:hover {
      background: var(--primary);
      color: var(--border-dark);
      border-style: solid;
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0px var(--border-dark);
    }

    /* ── Botón Principal de Acción ── */
    .btn-main {
      width: 100%;
      padding: 18px;
      background: var(--primary);
      border: var(--border-width) solid var(--border-dark);
      border-radius: 10px;
      color: var(--border-dark);
      font-family: 'Montserrat', sans-serif;
      font-size: 22px; 
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.1s;
      box-shadow: var(--shadow-solid-dark);
      margin-bottom: 10px;
    }

    .btn-main:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--border-dark);
      background: #4de0f0;
    }

    .btn-main:active { 
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0px var(--border-dark);
    }

    .btn-main:disabled {
      background: var(--text-dim);
      border-color: var(--bg-input);
      color: var(--bg-dark);
      box-shadow: none;
      cursor: not-allowed;
      transform: none;
    }

    /* ── Status ── */
    .status {
      margin-top: 20px;
      padding: 16px;
      border-radius: 8px;
      text-align: center;
      font-weight: 700;
      border: var(--border-width) solid var(--border-dark);
      display: none;
      box-shadow: var(--shadow-solid-dark);
      margin-bottom: 24px;
    }

    .status.loading { display: block; background: var(--primary); color: var(--border-dark); }
    .status.success { display: block; background: #10b981; color: #ffffff; }
    .status.error { display: block; background: #ef4444; color: #ffffff; }
    
    .status a {
      color: #ffffff;
      background: var(--border-dark);
      padding: 8px 16px;
      border-radius: 6px;
      text-decoration: none;
      border: 2px solid transparent;
      margin-top: 10px;
      display: inline-block;
      font-family: 'Montserrat', sans-serif;
      font-size: 15px;
      transition: all 0.15s ease-out;
    }

    .status a:hover {
      background: #ffffff;
      color: var(--border-dark);
      border-color: var(--border-dark);
    }

    /* ── Botón Nueva Operación ── */
    .btn-reset {
      background: #364494;
      color: #ffffff;
      border: 2px solid #ffffff;
      padding: 8px 16px;
      border-radius: 6px;
      font-family: 'Montserrat', sans-serif;
      font-size: 14px;
      cursor: pointer;
      font-weight: 700;
      margin-top: 12px;
      display: block;
      width: 100%;
      transition: all 0.2s;
    }
    
    .btn-reset:hover {
      background: #ffffff;
      color: #35B7C5; 
    }
      
    /* ── Animación Reloj ── */
    .clock-spinner {
      position: relative;
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid var(--border-dark);
      border-radius: 50%;
      vertical-align: middle;
      margin-right: 10px;
    }
    
    .clock-spinner::before,
    .clock-spinner::after {
      content: '';
      position: absolute;
      background-color: var(--border-dark);
      bottom: 50%;
      left: 50%;
      transform-origin: bottom center;
      border-radius: 2px;
    }
    
    .clock-spinner::before {
      width: 2.5px;
      height: 7px;
      margin-left: -1.25px;
      animation: spin 0.8s linear infinite;
    }
    
    .clock-spinner::after {
      width: 2.5px;
      height: 4px;
      margin-left: -1.25px;
      animation: spin 4s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ═══════════ NAVEGACIÓN (cuando se está dentro de un módulo) ═══════════ */
    .barra-nav { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 10px 22px; background: linear-gradient(100deg, #364494 0%, #2b377a 100%); border-bottom: 4px solid var(--primary); box-shadow: 0 6px 20px rgba(13, 18, 43, .28); }
    .nav-volver { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: #364494; border: none; border-radius: 10px; padding: 9px 16px; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 12.5px; letter-spacing: .2px; cursor: pointer; transition: transform .15s, box-shadow .15s; }
    .nav-volver:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(0, 0, 0, .25); }
    .nav-titulo { flex: 1; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 15px; color: #fff; letter-spacing: .2px; }
    .nav-usuario { font-size: 12px; font-weight: 600; color: #dbe3ff; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .22); padding: 6px 13px; border-radius: 999px; }
    .nav-pend, .nav-nov { display: inline-flex; align-items: center; gap: 6px; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 12px; padding: 7px 14px; border: none; border-radius: 999px; cursor: pointer; }
    .nav-pend { background: #ffb03b; color: #1a1200; animation: pulsoAtencion 2.2s ease-out infinite; }
    .nav-nov { background: rgba(53, 183, 197, .18); color: #bff3f8; border: 1px solid rgba(53, 183, 197, .55); }
    .nav-pend:hover, .nav-nov:hover { filter: brightness(1.1); }
    @keyframes pulsoAtencion { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 176, 59, 0.55); } 50% { box-shadow: 0 0 0 7px rgba(255, 176, 59, 0); } }

    /* ═══════════ SPLASH ═══════════ */
    body.splash-on { overflow: hidden; }
    #splash { position: fixed; inset: 0; z-index: 1000; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26px; cursor: pointer;
      background: radial-gradient(120% 90% at 50% 0%, #364494 0%, #232d61 48%, #11163a 100%); transition: transform .75s cubic-bezier(.77, 0, .18, 1), opacity .5s .25s; }
    #splash.out { transform: translateY(-102%); opacity: .6; pointer-events: none; }
    #splash::before { content: ""; position: absolute; inset: 0; opacity: .5; background-image: linear-gradient(rgba(53, 183, 197, .07) 1px, transparent 1px), linear-gradient(90deg, rgba(53, 183, 197, .07) 1px, transparent 1px); background-size: 46px 46px; -webkit-mask-image: radial-gradient(circle at 50% 45%, #000 0%, transparent 70%); mask-image: radial-gradient(circle at 50% 45%, #000 0%, transparent 70%); }
    .sp-logo { position: relative; background: #fff; border-radius: 22px; padding: 22px 48px; box-shadow: 0 24px 60px rgba(0, 0, 0, .4), 0 0 0 1px rgba(255, 255, 255, .5); animation: spIn .9s cubic-bezier(.2, .9, .25, 1) both; }
    .sp-logo img { display: block; height: 110px; width: auto; max-width: 320px; object-fit: contain; }
    .sp-logo b { display: block; font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 64px; color: #364494; letter-spacing: -.5px; }
